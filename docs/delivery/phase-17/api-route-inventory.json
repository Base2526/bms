{
  "schemaVersion": 1,
  "phase": 17,
  "mode": "API_AUTHORIZATION_CONTRACT",
  "productionAuthorized": false,
  "routes": [
    { "id": "liveness", "method": "GET", "pathTemplate": "/livez", "matcher": { "type": "STATIC", "literal": "/livez" }, "access": "PUBLIC_HEALTH", "scope": null, "idempotencyRequired": false },
    { "id": "readiness", "method": "GET", "pathTemplate": "/readyz", "matcher": { "type": "STATIC", "literal": "/readyz" }, "access": "PUBLIC_HEALTH", "scope": null, "idempotencyRequired": false },
    { "id": "reconciliation-issues", "method": "GET", "pathTemplate": "/v1/integration/reconciliation/issues", "matcher": { "type": "STATIC", "literal": "/v1/integration/reconciliation/issues" }, "access": "SERVICE", "scope": "reconciliation.read", "idempotencyRequired": false },
    { "id": "finance-capabilities", "method": "GET", "pathTemplate": "/v1/finance/capabilities", "matcher": { "type": "STATIC", "literal": "/v1/finance/capabilities" }, "access": "SERVICE", "scope": "finance.capabilities.read", "idempotencyRequired": false },
    { "id": "operations-overview", "method": "GET", "pathTemplate": "/v1/operations/overview", "matcher": { "type": "STATIC", "literal": "/v1/operations/overview" }, "access": "SERVICE", "scope": "operations.read", "idempotencyRequired": false },
    { "id": "operations-deliveries", "method": "GET", "pathTemplate": "/v1/operations/deliveries", "matcher": { "type": "STATIC", "literal": "/v1/operations/deliveries" }, "access": "SERVICE", "scope": "operations.read", "idempotencyRequired": false },
    { "id": "integration-events", "method": "POST", "pathTemplate": "/v1/integration/events", "matcher": { "type": "STATIC", "literal": "/v1/integration/events" }, "access": "SERVICE", "scope": "events.ingest", "idempotencyRequired": false },
    { "id": "merchant-configuration", "method": "PUT", "pathTemplate": "/v1/merchant/configuration", "matcher": { "type": "STATIC", "literal": "/v1/merchant/configuration" }, "access": "SERVICE", "scope": "merchant.settings.write", "idempotencyRequired": true },
    { "id": "quotes-create", "method": "POST", "pathTemplate": "/v1/quotes", "matcher": { "type": "STATIC", "literal": "/v1/quotes" }, "access": "SERVICE", "scope": "quotes.create", "idempotencyRequired": true },
    { "id": "deliveries-create", "method": "POST", "pathTemplate": "/v1/deliveries", "matcher": { "type": "STATIC", "literal": "/v1/deliveries" }, "access": "SERVICE", "scope": "deliveries.create", "idempotencyRequired": true },
    { "id": "dispatch-policy", "method": "PUT", "pathTemplate": "/v1/dispatch/policy", "matcher": { "type": "STATIC", "literal": "/v1/dispatch/policy" }, "access": "SERVICE", "scope": "dispatch.manage", "idempotencyRequired": true },
    { "id": "dispatch-drivers", "method": "PUT", "pathTemplate": "/v1/dispatch/drivers", "matcher": { "type": "STATIC", "literal": "/v1/dispatch/drivers" }, "access": "SERVICE", "scope": "dispatch.manage", "idempotencyRequired": true },
    { "id": "driver-availability", "method": "POST", "pathTemplate": "/v1/driver/availability", "matcher": { "type": "STATIC", "literal": "/v1/driver/availability" }, "access": "SERVICE", "scope": "driver.availability.write", "idempotencyRequired": true },
    { "id": "driver-locations", "method": "POST", "pathTemplate": "/v1/driver/locations", "matcher": { "type": "STATIC", "literal": "/v1/driver/locations" }, "access": "SERVICE", "scope": "driver.location.write", "idempotencyRequired": true },
    { "id": "driver-offers", "method": "GET", "pathTemplate": "/v1/driver/offers", "matcher": { "type": "STATIC", "literal": "/v1/driver/offers" }, "access": "SERVICE", "scope": "driver.offers.read", "idempotencyRequired": false },
    { "id": "driver-current-assignment", "method": "GET", "pathTemplate": "/v1/driver/assignments/current", "matcher": { "type": "STATIC", "literal": "/v1/driver/assignments/current" }, "access": "SERVICE", "scope": "driver.assignments.read", "idempotencyRequired": false },
    { "id": "driver-snapshot", "method": "GET", "pathTemplate": "/v1/driver/snapshot", "matcher": { "type": "STATIC", "literal": "/v1/driver/snapshot" }, "access": "SERVICE", "scope": "driver.snapshot.read", "idempotencyRequired": false },
    { "id": "driver-journey", "method": "POST", "pathTemplate": "/v1/driver/deliveries/:id/actions/:action", "matcher": { "type": "DYNAMIC", "variable": "driverJourneyMatch", "regexSource": "^\\/v1\\/driver\\/deliveries\\/([0-9a-f-]{36})\\/actions\\/(start_pickup|arrive_pickup)$" }, "access": "SERVICE", "scope": "driver.journey.write", "idempotencyRequired": true },
    { "id": "dispatch-start", "method": "POST", "pathTemplate": "/v1/deliveries/:id/actions/start_dispatch", "matcher": { "type": "DYNAMIC", "variable": "startDispatchMatch", "regexSource": "^\\/v1\\/deliveries\\/([0-9a-f-]{36})\\/actions\\/start_dispatch$" }, "access": "SERVICE", "scope": "dispatch.manage", "idempotencyRequired": true },
    { "id": "offer-decision", "method": "POST", "pathTemplate": "/v1/dispatch/offers/:id/:decision", "matcher": { "type": "DYNAMIC", "variable": "offerDecisionMatch", "regexSource": "^\\/v1\\/dispatch\\/offers\\/([0-9a-f-]{36})\\/(accept|reject)$" }, "access": "SERVICE", "scope": "driver.offers.decide", "idempotencyRequired": true },
    { "id": "delivery-transition", "method": "POST", "pathTemplate": "/v1/deliveries/:id/actions/:action", "matcher": { "type": "DYNAMIC", "variable": "actionMatch", "regexSource": "^\\/v1\\/deliveries\\/([0-9a-f-]{36})\\/actions\\/([a-z_]+)$" }, "access": "SERVICE", "scope": "deliveries.transition", "idempotencyRequired": true }
  ]
}
