**/node_modules/
.env
.env.*
!deploy/retail-local/.env.example
!infrastructure/fleet-delivery/.env.example
.next/
dist/
dist-smoke/
build/
out/
.DS_Store

apps/web/certs
apps/web/Caddyfile
# apps/web/package-lock.json
# apps/ws/package-lock.json
# apps/ws/src/db/package-lock.json

# packages/graphql-core/package-lock.json
# packages/realtime/package-lock.json

/storage/*
!/storage/.gitkeep

# Signed Retail Local release payloads are large deployment artifacts, never source files.
/releases/*
!/releases/retail-local/
/releases/retail-local/*
!/releases/retail-local/.gitignore
!/releases/retail-local/README.md
!/releases/retail-local/publish-retail-local-staged-release.sh

RN/MyApp/node_modules

# DB dumps/backups — ไฟล์ข้อมูลจริง อาจมี PII ห้าม commit (schema เก็บที่ db/migrations/ แทน)
db/*.sql
db/*.dump
!db/init.sql
*.dump

# local tool cache / build artifacts
.tokensave/*.db
.tokensave/*.db-shm
.tokensave/*.db-wal
*.tsbuildinfo

.pnpm-store/
# ผลการรันชุดเทส (scripts/run-contract-tests.mjs) — 249 KB ต่อรอบ และเป็นของเครื่องนั้น
.test-output/

# Local Fleet Delivery dev-auth keys, short-lived activation tokens and scenario manifests.
# These files are generated by npm run dev:bootstrap/dev:scenario and must never be committed.
/.local/

# Retail Local runtime data and backups contain shop PII, credentials, and DB dumps.
deploy/retail-local/data/
deploy/retail-local/backups/
deploy/retail-local/images/
deploy/retail-local/release.json
deploy/retail-local/installation.json
deploy/retail-local/license-ui/
deploy/retail-local/license-ui-host/
deploy/retail-local/doctor.json
artifacts/retail-local/
artifacts/bms-promo-animatic/
/secure/

# editor-local settings and generated repository snapshots
.vscode/
repomix-output.xml
