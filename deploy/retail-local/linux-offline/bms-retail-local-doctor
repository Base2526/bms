#!/usr/bin/env bash
set -euo pipefail
. /usr/lib/bms-retail-local/common.sh

failed=0
check() {
  local label=$1
  shift
  if "$@" >/dev/null 2>&1; then
    printf '[PASS] %s\n' "$label"
  else
    printf '[FAIL] %s\n' "$label" >&2
    failed=1
  fi
}

check architecture test "$(uname -m)" = x86_64
check docker-engine docker info
check docker-compose docker compose version
check installation test -f "$BMS_RUNTIME_ROOT/installation.json"
check secrets test -f "$BMS_ENV_FILE"
check compose-file test -f "$BMS_COMPOSE_FILE"

if [[ -f $BMS_ENV_FILE && -f $BMS_COMPOSE_FILE ]]; then
  check compose-config compose config --quiet
  web_port=$(env_value BMS_LOCAL_WEB_PORT)
  ws_port=$(env_value BMS_LOCAL_WS_PORT)
  check web curl --fail --silent --max-time 5 "http://127.0.0.1:${web_port}/admin/login"
  check websocket curl --fail --silent --max-time 5 "http://127.0.0.1:${ws_port}/readyz"
  compose ps
fi

(( failed == 0 )) || exit 1
