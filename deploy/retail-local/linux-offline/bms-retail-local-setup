#!/usr/bin/env bash

set -euo pipefail
. /usr/lib/bms-retail-local/common.sh

require_root
[[ $(uname -m) == x86_64 ]] || die "แพ็กเกจนี้รองรับ Linux x86_64 เท่านั้น"
require_docker
command -v openssl >/dev/null 2>&1 || die "ไม่พบ openssl"
command -v jq >/dev/null 2>&1 || die "ไม่พบ jq"
command -v sha256sum >/dev/null 2>&1 || die "ไม่พบ sha256sum"

install_embedded_pos() {
  if [[ -f $BMS_PAYLOAD_ROOT/BMS-POS.deb ]] && \
     ! dpkg-query -W -f='${Status}' bms-pos 2>/dev/null | grep -q 'install ok installed'; then
    printf 'กำลังติดตั้ง BMS POS...\n'
    dpkg --install "$BMS_PAYLOAD_ROOT/BMS-POS.deb" || \
      die "ติดตั้ง POS ไม่สำเร็จ กรุณารัน sudo apt install -f แล้วรัน setup ซ้ำ"
  fi
}

choose_archetype() {
  local labels=(
    'Mini Mart / Grocery' 'Fashion & Apparel' 'Home & Kitchen'
    'Beauty & Personal Care' 'Food & Beverage' 'Gadgets & Accessories'
    'B2B / Wholesale' 'Gifts & Seasonal' 'Pharmacy' 'Pet Supply'
    'Building Materials' 'Restaurant' 'Board Game Cafe' 'Other'
  )
  local values=(
    mini_mart fashion home_kitchen beauty_personal_care food_beverage
    gadgets_accessories b2b_wholesale gifts_seasonal pharmacy pet_supply
    building_materials restaurant board_game_cafe other
  )
  printf '\nประเภทร้าน (ใช้กำหนดค่าเริ่มต้นและตัวอย่างสินค้า)\n' >&2
  local index
  for index in "${!labels[@]}"; do printf '  %d. %s\n' "$((index + 1))" "${labels[$index]}" >&2; done
  while true; do
    read -r -p 'เลือกหมายเลข [1]: ' index
    index=${index:-1}
    if [[ $index =~ ^[0-9]+$ ]] && (( index >= 1 && index <= ${#values[@]} )); then
      printf '%s' "${values[$((index - 1))]}"
      return
    fi
    printf 'กรุณาเลือกหมายเลข 1-%d\n' "${#values[@]}" >&2
  done
}

choose_sample_mode() {
  local choice
  printf '\nStarter Catalog จะสร้างสินค้าตัวอย่างเป็น Draft, สต็อก 0 และยังขายไม่ได้\n' >&2
  while true; do
    read -r -p 'สร้าง Starter Catalog ตามประเภทร้านหรือไม่? [Y/n]: ' choice
    case ${choice:-Y} in
      Y|y) printf 'STARTER_CATALOG'; return ;;
      N|n) printf 'NONE'; return ;;
      *) printf 'กรุณาตอบ Y หรือ N\n' >&2 ;;
    esac
  done
}

available_kib=$(df --output=avail /var/lib | tail -n 1 | tr -d ' ')
(( available_kib >= 8 * 1024 * 1024 )) || die "พื้นที่ว่าง /var/lib ต้องมีอย่างน้อย 8 GiB"

if [[ -f $BMS_RUNTIME_ROOT/installation.json ]]; then
  install_embedded_pos
  printf 'ระบบติดตั้งแล้ว ใช้ sudo bms-retail-local-start เพื่อเริ่มบริการ\n'
  exit 0
fi

image_archive=$(find "$BMS_PAYLOAD_ROOT/images" -maxdepth 1 -type f -name '*.tar' -print -quit)
[[ -n $image_archive ]] || die "ไม่พบ Docker image archive ในแพ็กเกจ"
(cd "$BMS_PAYLOAD_ROOT" && sha256sum --check image.sha256)

install -d -m 0700 "$BMS_RUNTIME_ROOT" "$BMS_RUNTIME_ROOT/data/storage" "$BMS_RUNTIME_ROOT/backups"
install -m 0600 "$BMS_PAYLOAD_ROOT/compose.yml" "$BMS_COMPOSE_FILE"
install -m 0600 "$BMS_PAYLOAD_ROOT/release.json" "$BMS_RUNTIME_ROOT/release.json"

if [[ ! -f $BMS_ENV_FILE ]]; then
  umask 077
  image_tag=$(jq -r '.imageTag' "$BMS_PAYLOAD_ROOT/release.json")
  cat >"$BMS_ENV_FILE" <<EOF
POSTGRES_DB=bms_local
POSTGRES_PASSWORD=$(openssl rand -hex 24)
REDIS_PASSWORD=$(openssl rand -hex 24)
JWT_SECRET=$(openssl rand -hex 48)
BMS_SECRET_KEY=$(openssl rand -hex 32)
BMS_CHECKOUT_SECRET=$(openssl rand -hex 48)
BMS_CRON_SECRET=$(openssl rand -hex 32)
BMS_JOB_TOKEN=$(openssl rand -hex 32)
BMS_LOCAL_WEB_PORT=3100
BMS_LOCAL_WS_PORT=3101
BMS_LOCAL_IMAGE_TAG=$image_tag
EOF
fi
chmod 0600 "$BMS_ENV_FILE"

printf 'กำลังโหลด Docker images แบบ offline...\n'
docker load --input "$image_archive"
compose config --quiet

read -r -p 'ชื่อร้าน: ' shop_name
business_archetype=$(choose_archetype)
sample_mode=$(choose_sample_mode)
read -r -p 'ชื่อผู้ดูแลร้าน: ' admin_name
read -r -p 'อีเมลผู้ดูแลร้าน: ' admin_email
read -r -s -p 'รหัสผ่านผู้ดูแล (อย่างน้อย 8 ตัวอักษร): ' admin_password
printf '\n'
read -r -s -p 'PIN ขายหน้าร้าน (ตัวเลข 4-8 หลัก): ' admin_pin
printf '\n'
[[ -n $shop_name && -n $admin_name && -n $admin_email ]] || die "ข้อมูลร้านและผู้ดูแลห้ามว่าง"
(( ${#admin_password} >= 8 )) || die "รหัสผ่านต้องมีอย่างน้อย 8 ตัวอักษร"
[[ $admin_pin =~ ^[0-9]{4,8}$ ]] || die "PIN ต้องเป็นตัวเลข 4-8 หลัก"

export BMS_LOCAL_SHOP_NAME=$shop_name
export BMS_LOCAL_SHOP_SLUG=local-shop
export BMS_LOCAL_ADMIN_NAME=$admin_name
export BMS_LOCAL_ADMIN_EMAIL=$admin_email
export BMS_LOCAL_ADMIN_PASSWORD=$admin_password
export BMS_LOCAL_ADMIN_PIN=$admin_pin
export BMS_LOCAL_BUSINESS_ARCHETYPE=$business_archetype
export BMS_LOCAL_SAMPLE_MODE=$sample_mode
trap 'unset BMS_LOCAL_SHOP_NAME BMS_LOCAL_SHOP_SLUG BMS_LOCAL_ADMIN_NAME BMS_LOCAL_ADMIN_EMAIL BMS_LOCAL_ADMIN_PASSWORD BMS_LOCAL_ADMIN_PIN BMS_LOCAL_BUSINESS_ARCHETYPE BMS_LOCAL_SAMPLE_MODE' EXIT

printf 'กำลัง provision ร้าน...\n'
provision_output=$(compose --profile setup run --rm provision 2>&1) || {
  printf '%s\n' "$provision_output" >&2
  die "provision ร้านไม่สำเร็จ"
}
result=$(printf '%s\n' "$provision_output" | grep '^{' | tail -n 1 || true)
[[ -n $result ]] || die "provision สำเร็จแต่ไม่พบผลลัพธ์"

unset BMS_LOCAL_SHOP_NAME BMS_LOCAL_SHOP_SLUG BMS_LOCAL_ADMIN_NAME BMS_LOCAL_ADMIN_EMAIL BMS_LOCAL_ADMIN_PASSWORD BMS_LOCAL_ADMIN_PIN BMS_LOCAL_BUSINESS_ARCHETYPE BMS_LOCAL_SAMPLE_MODE
trap - EXIT
admin_password=
admin_pin=

compose up -d
wait_healthy

jq -n \
  --arg version "$(jq -r '.version' "$BMS_PAYLOAD_ROOT/release.json")" \
  --arg installedAt "$(date --iso-8601=seconds)" \
  --arg url "http://127.0.0.1:3100" \
  --arg tenantId "$(printf '%s' "$result" | jq -r '.tenantId')" \
  --arg adminUserId "$(printf '%s' "$result" | jq -r '.adminUserId')" \
  --arg posDeviceId "$(printf '%s' "$result" | jq -r '.deviceId')" \
  --arg businessArchetype "$(printf '%s' "$result" | jq -r '.businessArchetype')" \
  --arg sampleMode "$(printf '%s' "$result" | jq -r '.sample.mode')" \
  --arg sampleStatus "$(printf '%s' "$result" | jq -r '.sample.status')" \
  '{product:"BMS Retail Local",version:$version,installedAt:$installedAt,url:$url,tenantId:$tenantId,adminUserId:$adminUserId,posDeviceId:$posDeviceId,businessArchetype:$businessArchetype,sampleMode:$sampleMode,sampleStatus:$sampleStatus}' \
  >"$BMS_RUNTIME_ROOT/installation.json"
chmod 0600 "$BMS_RUNTIME_ROOT/installation.json"

install_embedded_pos

systemctl enable bms-retail-local.service >/dev/null 2>&1 || true

printf '\nBMS Retail Local พร้อมใช้งาน: http://127.0.0.1:3100\n'
printf 'Admin: %s\n' "$admin_email"
printf 'ประเภทร้าน: %s\n' "$(printf '%s' "$result" | jq -r '.businessArchetype')"
sample_status=$(printf '%s' "$result" | jq -r '.sample.status // "SKIPPED"')
if [[ $sample_status == FAILED ]]; then
  printf 'คำเตือน: Starter Catalog สร้างไม่สำเร็จ แต่ระบบหลักพร้อมใช้งาน: %s\n' \
    "$(printf '%s' "$result" | jq -r '.sample.error')"
elif [[ $sample_status == ACTIVE ]]; then
  printf 'สร้าง Starter Catalog แล้ว: %s สินค้า (Draft, สต็อก 0)\n' \
    "$(printf '%s' "$result" | jq -r '.sample.products')"
fi
device_token=$(printf '%s' "$result" | jq -r '.deviceToken // empty')
if [[ -n $device_token ]]; then
  printf '\nPOS pairing token (แสดงครั้งเดียว):\n%s\n' "$device_token"
  printf 'นำ token ไปจับคู่ใน BMS POS แล้วเก็บหรือทำลายบันทึกอย่างปลอดภัย\n'
fi
printf 'ตรวจระบบ: sudo bms-retail-local-doctor\n'
