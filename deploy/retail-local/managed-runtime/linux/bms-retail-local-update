#!/usr/bin/env bash
set -Eeuo pipefail

readonly bundle_root=/usr/lib/bms-retail-local/bootstrap
readonly release_url_file=/etc/bms-retail-local/release-manifest-url
mode=apply
case "${1:-}" in
  --check) mode=check; shift ;;
  --yes) mode=yes; shift ;;
esac
manifest_uri=${1:-}
[[ $# -le 1 ]] || {
  echo "usage: sudo bms-retail-local-update [--check|--yes] [SIGNED_RELEASE_MANIFEST_HTTPS_URL]" >&2
  exit 2
}
if [[ -z $manifest_uri && -f $release_url_file ]]; then
  manifest_uri=$(tr -d '\r\n' <"$release_url_file")
fi
if [[ -z $manifest_uri ]]; then
  echo "Release channel URL is not configured" >&2
  echo "usage: sudo bms-retail-local-update [--check|--yes] https://release.example/release.jws.json" >&2
  exit 2
fi
exec "$bundle_root/update-managed-runtime.sh" "$manifest_uri" "$bundle_root" "$mode"
