#!/usr/bin/env bash
set -Eeuo pipefail

status=/var/lib/bms-retail-local/offhost-backup-status.json
if [[ ! -f $status ]]; then
  echo "No off-host backup result is available"
  exit 1
fi
jq . "$status"
jq -e '.status == "passed"' "$status" >/dev/null
last_success=$(jq -er '.at' "$status")
last_epoch=$(date -u -d "$last_success" '+%s')
now_epoch=$(date -u '+%s')
if (( now_epoch - last_epoch > 172800 )); then
  echo "Warning: the latest off-host backup is older than 48 hours" >&2
  exit 1
fi
