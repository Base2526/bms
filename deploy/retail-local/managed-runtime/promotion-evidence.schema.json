{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bms.local/schemas/retail-local-promotion-evidence-v1.json",
  "title": "BMS Retail Local stable-channel promotion evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "product", "releaseVersion", "platformTarget", "sourceCommit", "gates"],
  "properties": {
    "formatVersion": { "const": 1 },
    "product": { "const": "BMS Retail Local" },
    "releaseVersion": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "platformTarget": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$" },
    "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "gates": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "verifiedAt", "validUntil", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$" },
          "status": { "const": "passed" },
          "verifiedAt": { "type": "string", "format": "date-time" },
          "validUntil": { "type": "string", "format": "date-time" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^https://" }
          }
        }
      }
    }
  }
}
