#!/bin/sh
set -eu

root=${BMS_RUNTIME_ROOT:-/var/lib/bms-retail-local}
case "$root" in /*) ;; *) echo "bms-update-transaction: Runtime root must be an absolute path" >&2; exit 1;; esac
[ "$root" != / ] || { echo "bms-update-transaction: Filesystem root is not allowed" >&2; exit 1; }
active="$root/update-active"
lock="$root/.update-transaction.lock"
die() { echo "bms-update-transaction: $*" >&2; exit 1; }
valid_version() { echo "$1" | grep -Eq '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[A-Za-z0-9.-]+)?$'; }
valid_ref() { echo "$1" | grep -Eq '^[a-z0-9][a-z0-9._/-]*:[A-Za-z0-9._-]+$'; }
transaction_dir() { printf '%s/updates/%s' "$root" "$1"; }
read_phase() { cat "$(transaction_dir "$1")/phase" 2>/dev/null || printf 'unknown'; }
write_phase() {
  directory=$(transaction_dir "$1")
  printf '%s\n' "$2" >"$directory/phase.tmp"
  chmod 0600 "$directory/phase.tmp"
  mv -f "$directory/phase.tmp" "$directory/phase"
  sync -f "$directory" 2>/dev/null || true
}
compose() { docker compose --env-file "$root/.env" -f "$root/compose.yml" "$@"; }
replace_ref() {
  key=$1 value=$2 file=$3
  [ "$(grep -Ec "^${key}=" "$file")" -eq 1 ] || die "Invalid $key in .env"
  sed "s|^${key}=.*$|${key}=${value}|" "$file" >"$file.next"
  mv -f "$file.next" "$file"
}
wait_healthy() {
  remaining=80
  while [ "$remaining" -gt 0 ]; do
    if bms-localctl doctor >/dev/null 2>&1; then return 0; fi
    remaining=$((remaining - 1))
    sleep 3
  done
  return 1
}
unlock() { rm -f "$lock/pid" 2>/dev/null || true; rmdir "$lock" 2>/dev/null || true; }
take_lock() {
  # Serialize registration with both the receipt snapshot and final replacement.
  umask 077
  exec 9>"$root/.license-ui.lock"
  flock -w 60 9 || die "License registration or restore is still running; retry later."
  if ! mkdir "$lock" 2>/dev/null; then
    owner=$(cat "$lock/pid" 2>/dev/null || true)
    case "$owner" in *[!0-9]*|'') owner=0;; esac
    if [ "$owner" -gt 0 ] && kill -0 "$owner" 2>/dev/null; then
      die "Another update transaction is running"
    fi
    rm -f "$lock/pid" 2>/dev/null || true
    rmdir "$lock" 2>/dev/null || die "Update lock is damaged. Contact Support"
    mkdir "$lock" || die "Failed to create update lock"
  fi
  printf '%s\n' "$$" >"$lock/pid"
  trap unlock EXIT
  trap 'exit 130' HUP INT TERM
}

rollback() {
  version=$1 directory=$(transaction_dir "$1")
  [ -d "$directory" ] || die "Transaction not found: $version"
  rollback_safe=$(cat "$directory/rollback-safe" 2>/dev/null || printf '0')
  backup=$(cat "$directory/backup-path" 2>/dev/null || true)
  write_phase "$version" rolling-back
  compose stop web ws >/dev/null 2>&1 || true
  install -m 0600 "$directory/old.env" "$root/.env"
  install -m 0600 "$directory/old.compose.yml" "$root/compose.yml"
  if [ "$rollback_safe" = 1 ]; then
    compose up -d --remove-orphans
    wait_healthy || die "Image rollback completed but the previous services did not become healthy"
  else
    [ -f "$backup" ] || die "Pre-update backup was not found for rollback"
    BMS_LICENSE_LOCK_HELD=1 bms-localctl restore "$backup" REPLACE-LOCAL-DATA --identity "$root/update-recovery.agekey"
  fi
  if [ -f "$directory/old.installation.json" ]; then
    install -m 0600 "$directory/old.installation.json" "$root/installation.json"
  fi
  write_phase "$version" rolled-back
  rm -f "$active"
}

case "${1:-}" in
  prepare)
    for file in .env compose.yml installation.json; do
      [ -f "$root/$file" ] || die "Existing installation is incomplete: $file. Preserve shop data and collect diagnostics."
    done
    take_lock
    [ ! -e "$active" ] || die "An interrupted update needs recovery before another update can start."
    timeout 20 docker info >/dev/null 2>&1 || die "Docker is not ready. Restart the private runtime and retry."
    if timeout 10 bms-localctl doctor >/dev/null 2>&1; then exit 0; fi
    echo "Starting existing shop containers; no image, database or secret changes."
    # Never use up here: tags may have moved, and dependencies can include migrations.
    timeout 120 docker compose --env-file "$root/.env" -f "$root/compose.yml" \
      start postgres redis web ws || die "Could not start existing containers. No update was applied; collect runtime diagnostics."
    started=$(date +%s)
    deadline=$((started + 180))
    while [ "$(date +%s)" -lt "$deadline" ]; do
      if timeout 10 bms-localctl doctor >/dev/null 2>&1; then
        echo "Existing shop is healthy; update preparation can continue."
        exit 0
      fi
      echo "Waiting for existing shop health ($(( $(date +%s) - started ))/180 seconds)..."
      sleep 3
    done
    timeout 10 bms-localctl doctor >&2 || true
    die "Existing shop is still unhealthy. No update was applied. Preserve data and collect PostgreSQL/runtime diagnostics."
    ;;
  begin)
    shift
    [ "$#" -eq 6 ] || die "usage: begin VERSION ROLLBACK_SAFE WEB_REF WS_REF POSTGRES_REF REDIS_REF"
    version=$1 rollback_safe=$2 web_ref=$3 ws_ref=$4 postgres_ref=$5 redis_ref=$6
    valid_version "$version" || die "Invalid release version"
    [ "$rollback_safe" = 0 ] || [ "$rollback_safe" = 1 ] || die "rollback-safe must be 0 or 1"
    for ref in "$web_ref" "$ws_ref" "$postgres_ref" "$redis_ref"; do valid_ref "$ref" || die "Invalid image reference"; done
    if [ ! -f "$root/.env" ] || [ ! -f "$root/compose.yml" ] || [ ! -f "$root/installation.json" ]; then
      die "Runtime installation is incomplete"
    fi
    [ ! -e "$active" ] || die "An update transaction must be recovered first"
    directory=$(transaction_dir "$version")
    [ -f "$directory/compose.next.yml" ] || die "Verified compose.next.yml was not found"
    take_lock
    mkdir -p "$root/backups" "$root/updates"
    chmod 0700 "$root/backups" "$root/updates" "$directory"
    bms-localctl doctor >/dev/null || die "Existing runtime is not healthy; update refused"
    install -m 0600 "$root/.env" "$directory/old.env"
    install -m 0600 "$root/compose.yml" "$directory/old.compose.yml"
    install -m 0600 "$root/installation.json" "$directory/old.installation.json"
    printf '%s\n' "$rollback_safe" >"$directory/rollback-safe"
    if [ ! -f "$root/update-recovery.agekey" ]; then
      age-keygen -o "$root/update-recovery.agekey.tmp" >/dev/null
      chmod 0600 "$root/update-recovery.agekey.tmp"
      mv -f "$root/update-recovery.agekey.tmp" "$root/update-recovery.agekey"
    fi
    recipient=$(age-keygen -y "$root/update-recovery.agekey")
    # A rolled-back or interrupted attempt keeps its backup; a retry needs a fresh snapshot.
    backup_directory=$(mktemp -d "$root/backups/pre-update-$version.XXXXXX")
    backup="$backup_directory/backup.age"
    bms-localctl backup "$backup" --recipient "$recipient" >/dev/null
    age -d -i "$root/update-recovery.agekey" -o /dev/null "$backup" || die "Pre-update backup verification failed"
    printf '%s\n' "$backup" >"$directory/backup-path"
    write_phase "$version" backed-up
    printf '%s\n' "$version" >"$active.tmp"
    chmod 0600 "$active.tmp"
    mv -f "$active.tmp" "$active"

    install -m 0600 "$directory/old.env" "$directory/env.next"
    replace_ref BMS_WEB_IMAGE_REF "$web_ref" "$directory/env.next"
    replace_ref BMS_WS_IMAGE_REF "$ws_ref" "$directory/env.next"
    replace_ref BMS_POSTGRES_IMAGE_REF "$postgres_ref" "$directory/env.next"
    replace_ref BMS_REDIS_IMAGE_REF "$redis_ref" "$directory/env.next"
    compose stop web ws >/dev/null
    install -m 0600 "$directory/compose.next.yml" "$root/compose.yml"
    install -m 0600 "$directory/env.next" "$root/.env"
    write_phase "$version" switched
    if ! compose run --rm migrate || ! compose up -d --remove-orphans || ! wait_healthy; then
      echo "Update failed the health check; rolling back" >&2
      rollback "$version"
      exit 1
    fi
    write_phase "$version" runtime-healthy
    ;;
  commit)
    version=${2:-}
    valid_version "$version" || die "Invalid release version"
    take_lock
    directory=$(transaction_dir "$version")
    [ "$(read_phase "$version")" = runtime-healthy ] || die "Transaction is not ready to commit"
    [ -f "$directory/installation.next.json" ] || die "installation.next.json was not found"
    bms-localctl doctor >/dev/null || die "Services are not healthy; commit refused"
    install -m 0600 "$directory/installation.next.json" "$root/installation.json"
    write_phase "$version" committed
    rm -f "$active"
    ;;
  rollback)
    version=${2:-}
    valid_version "$version" || die "Invalid release version"
    take_lock
    rollback "$version"
    ;;
  recover)
    [ -f "$active" ] || exit 0
    version=$(cat "$active")
    valid_version "$version" || die "update-active is damaged. Contact Support"
    phase=$(read_phase "$version")
    if [ "$phase" = committed ] || [ "$phase" = rolled-back ]; then
      rm -f "$active"
      exit 0
    fi
    take_lock
    echo "Found an interrupted update in phase $phase; rolling back" >&2
    rollback "$version"
    ;;
  *)
    die "usage: bms-update-transaction <prepare|begin|commit|rollback|recover> ..."
    ;;
esac
