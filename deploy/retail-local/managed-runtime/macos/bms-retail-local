#!/bin/bash
set -Eeuo pipefail
umask 077

readonly SYSTEM_ROOT="${BMS_RETAIL_LOCAL_SYSTEM_ROOT:-/Library/Application Support/BMS/RetailLocal}"
readonly CONTROL_ROOT="$SYSTEM_ROOT/control"
readonly BOOTSTRAP_ROOT="$SYSTEM_ROOT/bootstrap"
readonly EMBEDDED_PAYLOAD_ROOT="$SYSTEM_ROOT/payload"
readonly EMBEDDED_RUNTIME_ROOT="$SYSTEM_ROOT/runtime"
readonly STATE_ROOT="${BMS_RETAIL_LOCAL_STATE_ROOT:-$HOME/Library/Application Support/BMS/RetailLocal}"
readonly LIMA_HOME="${BMS_RETAIL_LOCAL_LIMA_HOME:-$HOME/.bmsrl}"
readonly INSTANCE="${BMS_RETAIL_LOCAL_INSTANCE:-bms-retail-local}"
readonly WEB_PORT="${BMS_RETAIL_LOCAL_HOST_WEB_PORT:-3100}"
readonly WS_PORT="${BMS_RETAIL_LOCAL_HOST_WS_PORT:-3101}"
readonly RECEIPT="$STATE_ROOT/installation.json"
readonly CONFIG="$STATE_ROOT/lima.yaml"
readonly LAUNCH_AGENT="$HOME/Library/LaunchAgents/com.bms.retail-local.plist"
readonly LICENSE_UI_AGENT="$HOME/Library/LaunchAgents/com.bms.retail-local.license-ui.plist"
readonly LOG_PATH="$STATE_ROOT/host-service.log"
RELEASE_DIRECTORY=""
RELEASE_JSON=""
RUNTIME_ROOT=""
PAYLOAD_ROOT=""
LIMACTL=""
AGENT=""
KEYRING=""
MANIFEST_URI_FILE=""
INSTALL_MODE=""
PROVISION_DEVICE_TOKEN=""
PROVISION_SAMPLE_STATUS=""
PROVISION_TENANT_ID=""
PROVISION_POS_DEVICE_ID=""
LICENSE_ID=""
LICENSE_EVIDENCE_ENDPOINT=""
LICENSE_EVIDENCE_TOKEN=""
SHOP_NAME=""
ADMIN_NAME=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_PIN=""
BUSINESS_ARCHETYPE=""
SAMPLE_MODE="NONE"
LAUNCH_LABEL="gui/$(id -u)/com.bms.retail-local"
readonly LAUNCH_LABEL

export LIMA_HOME
export PATH="/usr/bin:/bin:/usr/sbin:/sbin"

if [[ -d $BOOTSTRAP_ROOT ]]; then
  INSTALL_MODE=online
  AGENT="$BOOTSTRAP_ROOT/bms-runtime-agent"
  KEYRING="$BOOTSTRAP_ROOT/trusted-release-keys.json"
  MANIFEST_URI_FILE="$BOOTSTRAP_ROOT/manifest-url"
else
  INSTALL_MODE=offline
  RUNTIME_ROOT="$EMBEDDED_RUNTIME_ROOT"
  PAYLOAD_ROOT="$EMBEDDED_PAYLOAD_ROOT"
  LIMACTL="$RUNTIME_ROOT/lima/bin/limactl"
  AGENT="$PAYLOAD_ROOT/bin/bms-runtime-agent"
  export BMS_LIMACTL_PATH="$LIMACTL"
  export PATH="$RUNTIME_ROOT/lima/bin:$RUNTIME_ROOT/lima/libexec:/usr/bin:/bin:/usr/sbin:/sbin"
fi

die() { BMS_DIAG_REASON=$*; BMS_DIAG_LINE=${BASH_LINENO[0]}; printf 'BMS Retail Local: %s\n' "$*" >&2; exit 1; }
note() { printf '[BMS] %s\n' "$*"; }
step() { BMS_DIAG_STAGE="step-$1-of-7"; printf '\n[BMS %s/7] %s\n' "$1" "$2"; }
uninstall_step() { printf '\n[BMS Uninstall %s/4] %s\n' "$1" "$2"; }
run_with_timeout() {
  local seconds=$1 command_pid timer_pid status=0 timeout_marker
  shift
  timeout_marker=$(mktemp "${TMPDIR:-/tmp}/bms-retail-local-timeout.XXXXXX")
  rm -f -- "$timeout_marker"
  "$@" &
  command_pid=$!
  (
    sleep "$seconds"
    if kill -0 "$command_pid" 2>/dev/null; then
      : >"$timeout_marker"
      kill -TERM "$command_pid" 2>/dev/null || true
      sleep 2
      kill -KILL "$command_pid" 2>/dev/null || true
    fi
  ) &
  timer_pid=$!
  wait "$command_pid" || status=$?
  kill "$timer_pid" 2>/dev/null || true
  wait "$timer_pid" 2>/dev/null || true
  if [[ -f $timeout_marker ]]; then
    rm -f -- "$timeout_marker"
    return 124
  fi
  rm -f -- "$timeout_marker"
  return "$status"
}
require_bootstrap() {
  if [[ $INSTALL_MODE == offline ]]; then
    [[ -x $AGENT && -x $LIMACTL && -f $PAYLOAD_ROOT/SHA256SUMS ]] || \
      die "ไฟล์ Offline Recovery Installer ไม่ครบ กรุณาติดตั้ง .pkg ใหม่"
    return
  fi
  [[ -x $AGENT && -f $KEYRING && -f $MANIFEST_URI_FILE ]] || \
    die "ไฟล์ Online Bootstrap ไม่ครบ กรุณาติดตั้ง .pkg ใหม่"
}
package_type() {
  local value=""
  if [[ -f $RECEIPT ]]; then
    value=$(/usr/bin/plutil -extract packageType raw -o - "$RECEIPT" 2>/dev/null || true)
  fi
  if [[ -z $value ]]; then
    if [[ $INSTALL_MODE == online ]]; then
      value=$(cat "$BOOTSTRAP_ROOT/PACKAGE_TYPE" 2>/dev/null || true)
    else
      value=$(cat "$PAYLOAD_ROOT/PACKAGE_TYPE" 2>/dev/null || true)
    fi
  fi
  case "$value" in
    server|server-pos) printf '%s\n' "$value" ;;
    *) printf '%s\n' server-pos ;;
  esac
}
is_https_url() {
  [[ ${1:-} =~ ^https://[^/@:]+(:[0-9]{1,5})?([/?#].*)?$ && ${1:-} != *'@'* ]]
}
artifact_path() {
  local name=${1//./-}
  if [[ $INSTALL_MODE == offline ]]; then
    case "$name" in
      web|ws|postgres|redis) printf '%s/images/%s.artifact' "$PAYLOAD_ROOT" "$name" ;;
      compose|shop-archetypes) printf '%s/%s.artifact' "$PAYLOAD_ROOT" "$name" ;;
      *) printf '%s/%s.artifact' "$PAYLOAD_ROOT" "$name" ;;
    esac
    return
  fi
  printf '%s/%s.artifact' "$RELEASE_DIRECTORY" "$name"
}
load_release_paths() {
  local version=${1:-}
  if [[ $INSTALL_MODE == offline ]]; then
    return
  fi
  [[ $version =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || die "release version ไม่ถูกต้อง"
  RELEASE_DIRECTORY="$STATE_ROOT/releases/$version"
  RELEASE_JSON="$RELEASE_DIRECTORY/release.json"
  RUNTIME_ROOT="$STATE_ROOT/runtimes/$version"
  PAYLOAD_ROOT="$RUNTIME_ROOT/payload"
  LIMACTL="$RUNTIME_ROOT/runtime/lima/bin/limactl"
  export BMS_LIMACTL_PATH="$LIMACTL"
  export PATH="$RUNTIME_ROOT/runtime/lima/bin:$RUNTIME_ROOT/runtime/lima/libexec:/usr/bin:/bin:/usr/sbin:/sbin"
}
embedded_installation_available() {
  [[ -x $EMBEDDED_RUNTIME_ROOT/lima/bin/limactl && \
     -x $EMBEDDED_PAYLOAD_ROOT/bin/bms-runtime-agent && \
     -f $EMBEDDED_PAYLOAD_ROOT/SHA256SUMS && \
     -f $CONFIG && -d $LIMA_HOME/$INSTANCE ]]
}
activate_embedded_installation() {
  INSTALL_MODE=offline
  RUNTIME_ROOT="$EMBEDDED_RUNTIME_ROOT"
  PAYLOAD_ROOT="$EMBEDDED_PAYLOAD_ROOT"
  LIMACTL="$RUNTIME_ROOT/lima/bin/limactl"
  AGENT="$PAYLOAD_ROOT/bin/bms-runtime-agent"
  KEYRING=""
  MANIFEST_URI_FILE=""
  RELEASE_DIRECTORY=""
  RELEASE_JSON=""
  export BMS_LIMACTL_PATH="$LIMACTL"
  export PATH="$RUNTIME_ROOT/lima/bin:$RUNTIME_ROOT/lima/libexec:/usr/bin:/bin:/usr/sbin:/sbin"
}
online_installation_available() {
  [[ -x $LIMACTL && -f $RELEASE_JSON && -f $RELEASE_DIRECTORY/web.artifact && \
     -f $PAYLOAD_ROOT/ubuntu-24.04-server-cloudimg.img ]]
}
load_installed_release() {
  [[ -f $RECEIPT ]] || die "ยัง setup ไม่เสร็จ"
  if [[ $INSTALL_MODE == offline ]]; then
    return
  fi
  local version
  version=$(/usr/bin/plutil -extract version raw -o - "$RECEIPT" 2>/dev/null || true)
  load_release_paths "$version"
  if ! online_installation_available && embedded_installation_available; then
    activate_embedded_installation
    note "พบข้อมูลร้านจาก Offline Installer เดิม กำลังเปิดระบบเดิมต่อโดยไม่แตะข้อมูลร้าน"
  fi
}
require_installed_payload() {
  require_bootstrap
  if [[ $INSTALL_MODE == offline ]]; then
    if [[ -f $RECEIPT ]]; then
      [[ -x $LIMACTL && -x $AGENT && -f $PAYLOAD_ROOT/SHA256SUMS && \
         -f $CONFIG && -d $LIMA_HOME/$INSTANCE ]] || \
        die "ไฟล์ระบบเดิมไม่ครบ แต่ข้อมูลร้านอาจยังอยู่ กรุณาติดต่อ Support และอย่าลบ private VM"
    else
      [[ -x $LIMACTL && -x $AGENT && -f $PAYLOAD_ROOT/SHA256SUMS && \
         -f $PAYLOAD_ROOT/ubuntu-24.04-server-cloudimg.img ]] || \
        die "ไฟล์ใน Offline Recovery Installer ไม่ครบ กรุณาติดตั้ง .pkg ใหม่"
    fi
    return
  fi
  [[ -x $LIMACTL && -f $RELEASE_JSON && -f "$(artifact_path web)" && -f $PAYLOAD_ROOT/ubuntu-24.04-server-cloudimg.img ]] || \
    die "พบข้อมูลการติดตั้งเดิม แต่ runtime release ไม่ครบ กรุณาติดต่อ Support และอย่าลบข้อมูลร้าน"
}
instance_status() {
  "$LIMACTL" list "$INSTANCE" --format '{{.Status}}' 2>/dev/null | tr -d '\r' || true
}
guest() { "$LIMACTL" shell "$INSTANCE" "$@"; }
yaml_escape_sed() { printf '%s' "$1" | sed -e 's/[&|]/\\&/g'; }
# Lima's local file fetcher opens the literal file:// path and does not URL-decode %20.
file_uri() { printf 'file://%s' "$1"; }
random_suffix() { od -An -N 6 -tx1 /dev/urandom | tr -d ' \n'; }

verify_embedded_payload() {
  note "ตรวจ checksum ของ runtime และ server images"
  (cd "$PAYLOAD_ROOT" && shasum -a 256 -c SHA256SUMS >/dev/null) || \
    die "checksum ของไฟล์ใน Offline Recovery Installer ไม่ถูกต้อง"
}

require_matching_mac_architecture() {
  local packaged_target host_arch
  if [[ $INSTALL_MODE == online ]]; then
    packaged_target=$(cat "$BOOTSTRAP_ROOT/PLATFORM_TARGET" 2>/dev/null || true)
  else
    packaged_target=$(cat "$PAYLOAD_ROOT/PLATFORM_TARGET" 2>/dev/null || true)
  fi
  if [[ $(/usr/sbin/sysctl -n hw.optional.arm64 2>/dev/null || printf '0') == 1 ]]; then
    host_arch=arm64
  else
    host_arch=x64
  fi
  [[ $packaged_target == "macos-15-$host_arch" ]] || \
    die "ไฟล์ติดตั้งไม่ตรงกับ CPU เครื่องนี้ (เครื่องเป็น $host_arch แต่ package เป็น ${packaged_target:-unknown})"
}

activate_license() {
  [[ $INSTALL_MODE == online ]] || return 0
  local activation_uri checkpoint code body response license_id evidence_token origin
  activation_uri=$(tr -d '\r\n' <"$BOOTSTRAP_ROOT/activation-url" 2>/dev/null || true)
  [[ -n $activation_uri ]] || return 0
  if ! is_https_url "$activation_uri"; then
    printf '[คำเตือน] Activation URL ไม่ปลอดภัย ข้าม Activation และให้ร้านใช้งานต่อ\n' >&2
    return 0
  fi
  checkpoint="$STATE_ROOT/activation.json"
  if [[ -f $checkpoint ]]; then
    LICENSE_ID=$(/usr/bin/plutil -extract licenseId raw -o - "$checkpoint" 2>/dev/null || true)
    LICENSE_EVIDENCE_ENDPOINT=$(/usr/bin/plutil -extract evidenceEndpoint raw -o - "$checkpoint" 2>/dev/null || true)
    LICENSE_EVIDENCE_TOKEN=$(/usr/bin/plutil -extract evidenceToken raw -o - "$checkpoint" 2>/dev/null || true)
    [[ -z $LICENSE_ID ]] || return 0
  fi

  # Setup may recover an already-redeemed code after interruption, but only the
  # explicit post-install activate command can prompt or contact the control plane.
  [[ ${1:-} == interactive ]] || return 0
  read -r -s -p 'Activation Code จาก BMS (เว้นว่างเพื่อยกเลิก): ' code
  printf '\n'
  [[ -n $code ]] || return 0
  body="$STATE_ROOT/.activation-body-$(random_suffix).json"
  response="$STATE_ROOT/.activation-response-$(random_suffix).json"
  /usr/bin/plutil -create xml1 "$body"
  /usr/bin/plutil -insert activationCode -string "$code" "$body"
  /usr/bin/plutil -convert json "$body"
  code=""
  if ! curl --fail --silent --show-error --max-time 15 -H 'Content-Type: application/json' \
      --data-binary "@$body" --output "$response" "$activation_uri"; then
    rm -f -- "$body" "$response"
    printf '[คำเตือน] Activation ยังไม่สำเร็จ แต่ร้านจะติดตั้งและใช้งานต่อได้ กรุณาติดต่อ Support ภายหลัง\n' >&2
    return 0
  fi
  rm -f -- "$body"
  license_id=$(/usr/bin/plutil -extract licenseCode raw -o - "$response" 2>/dev/null || true)
  evidence_token=$(/usr/bin/plutil -extract ingestionToken raw -o - "$response" 2>/dev/null || true)
  rm -f -- "$response"
  if [[ ! $license_id =~ ^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$ || \
        ! $evidence_token =~ ^[A-Za-z0-9_-]{32,256}$ || \
        ! $activation_uri =~ ^(https://[^/@:]+(:[0-9]{1,5})?)([/?#].*)?$ ]]; then
    printf '[คำเตือน] Activation response ไม่ถูกต้อง แต่ร้านจะติดตั้งและใช้งานต่อได้\n' >&2
    return 0
  fi
  origin=${BASH_REMATCH[1]}
  LICENSE_ID=$license_id
  LICENSE_EVIDENCE_ENDPOINT="$origin/api/bms/retail-local/license-evidence"
  LICENSE_EVIDENCE_TOKEN=$evidence_token
  /usr/bin/plutil -create xml1 "$checkpoint"
  /usr/bin/plutil -insert licenseId -string "$LICENSE_ID" "$checkpoint"
  /usr/bin/plutil -insert evidenceEndpoint -string "$LICENSE_EVIDENCE_ENDPOINT" "$checkpoint"
  /usr/bin/plutil -insert evidenceToken -string "$LICENSE_EVIDENCE_TOKEN" "$checkpoint"
  /usr/bin/plutil -convert json "$checkpoint"
  chmod 0600 "$checkpoint"
  note "Activation สำเร็จ"
}

activate_installed_license() {
  local event=INSTALLATION_REGISTERED runtime_receipt tenant_id device_id target version old_license
  [[ ${1:-} == --transfer || -z ${1:-} ]] || die "usage: bms-retail-local activate [--transfer]"
  [[ -f $RECEIPT ]] || die "กรุณาติดตั้ง BMS Retail Local ก่อนลงทะเบียน"
  [[ $INSTALL_MODE == online && -s $BOOTSTRAP_ROOT/activation-url ]] || die "bootstrap ไม่มี Activation URL"
  ensure_runtime
  # Validate the authoritative shop receipt before consuming a one-use code.
  runtime_receipt=$(mktemp "$STATE_ROOT/.activation-receipt.XXXXXX")
  rm -f -- "$runtime_receipt" # runtime-read creates the destination exclusively.
  if ! "$AGENT" runtime-read -engine macos-lima -distro "$INSTANCE" \
      -source /var/lib/bms-retail-local/installation.json -destination "$runtime_receipt" >/dev/null; then
    rm -f -- "$runtime_receipt"
    die "อ่าน installation receipt ไม่สำเร็จ ร้านยังใช้งานได้"
  fi
  tenant_id=$(/usr/bin/plutil -extract tenantId raw -o - "$runtime_receipt" 2>/dev/null || true)
  device_id=$(/usr/bin/plutil -extract posDeviceId raw -o - "$runtime_receipt" 2>/dev/null || true)
  target=$(/usr/bin/plutil -extract platformTarget raw -o - "$runtime_receipt" 2>/dev/null || true)
  version=$(/usr/bin/plutil -extract version raw -o - "$runtime_receipt" 2>/dev/null || true)
  old_license=$(/usr/bin/plutil -extract licenseCode raw -o - "$runtime_receipt" 2>/dev/null || true)
  if [[ -z $tenant_id || -z $device_id || -z $target || -z $version ]]; then
    rm -f -- "$runtime_receipt"
    die "installation receipt ไม่ครบ กรุณาติดต่อ Support"
  fi
  [[ ${1:-} != --transfer && -z $old_license ]] || event=TRANSFER_REQUESTED
  activate_license interactive
  if [[ -z $LICENSE_ID ]]; then
    rm -f -- "$runtime_receipt"
    note "ยังไม่ได้ลงทะเบียน ร้านยังใช้งานได้ ลงทะเบียนภายหลังด้วย bms-retail-local activate"
    return 0
  fi
  if ! BMS_LICENSE_EVIDENCE_TOKEN="$LICENSE_EVIDENCE_TOKEN" "$AGENT" license-record \
      -root "$STATE_ROOT" -event "$event" -license-id "$LICENSE_ID" \
      -tenant-id "$tenant_id" -pos-device-id "$device_id" -target "$target" \
      -release-version "$version" -endpoint "$LICENSE_EVIDENCE_ENDPOINT" >/dev/null; then
    rm -f -- "$runtime_receipt"
    die "บันทึกการลงทะเบียนยังไม่สำเร็จ ร้านยังใช้งานได้ ลอง bms-retail-local activate อีกครั้ง"
  fi
  /usr/bin/plutil -remove licenseCode "$runtime_receipt" 2>/dev/null || true
  /usr/bin/plutil -insert licenseCode -string "$LICENSE_ID" "$runtime_receipt"
  /usr/bin/plutil -convert json "$runtime_receipt"
  if ! "$AGENT" runtime-write -engine macos-lima -distro "$INSTANCE" -source "$runtime_receipt" \
      -destination /var/lib/bms-retail-local/installation.json -mode 0600 >/dev/null; then
    rm -f -- "$runtime_receipt"
    die "บันทึก receipt ยังไม่สำเร็จ ร้านยังใช้งานได้ ลอง bms-retail-local activate อีกครั้ง"
  fi
  mv -f "$runtime_receipt" "$RECEIPT"
  rm -f -- "$STATE_ROOT/activation.json"
  LICENSE_EVIDENCE_TOKEN=""
  note "ลงทะเบียนสำเร็จ ร้านและข้อมูลเดิมพร้อมใช้งาน"
}

release_component_value() {
  local wanted=$1 field=$2 index=0 name
  if [[ $INSTALL_MODE == offline ]]; then
    case "$field" in
      imageRef) awk -F '\t' -v component="$wanted" '$1 == component {print $3}' "$PAYLOAD_ROOT/release-images.tsv" ;;
      ociDigest) awk -F '\t' -v component="$wanted" '$1 == component {print $4}' "$PAYLOAD_ROOT/release-images.tsv" ;;
      *) die "offline release ไม่มี field $field" ;;
    esac
    return
  fi
  while name=$(/usr/bin/plutil -extract "components.$index.name" raw -o - "$RELEASE_JSON" 2>/dev/null); do
    if [[ $name == "$wanted" ]]; then
      /usr/bin/plutil -extract "components.$index.$field" raw -o - "$RELEASE_JSON"
      return
    fi
    index=$((index + 1))
  done
  die "signed release ขาด component $wanted"
}

render_stage_output() {
  local line payload phase component percent completed total heartbeat retry_after progress_size
  while IFS= read -r line; do
    printf '%s\n' "$line" >>"$1"
    if [[ $line == 'BMS_PROGRESS '* ]]; then
      payload=${line#BMS_PROGRESS }
      phase=$(printf '%s' "$payload" | /usr/bin/plutil -extract phase raw -o - - 2>/dev/null) || phase=''
      component=$(printf '%s' "$payload" | /usr/bin/plutil -extract component raw -o - - 2>/dev/null) || component='release'
      percent=$(printf '%s' "$payload" | /usr/bin/plutil -extract percent raw -o - - 2>/dev/null) || percent='0'
      completed=$(printf '%s' "$payload" | /usr/bin/plutil -extract componentCompletedBytes raw -o - - 2>/dev/null) || completed='0'
      total=$(printf '%s' "$payload" | /usr/bin/plutil -extract componentTotalBytes raw -o - - 2>/dev/null) || total='0'
      heartbeat=$(printf '%s' "$payload" | /usr/bin/plutil -extract heartbeat raw -o - - 2>/dev/null) || heartbeat='false'
      retry_after=$(printf '%s' "$payload" | /usr/bin/plutil -extract retryAfterSeconds raw -o - - 2>/dev/null) || retry_after='0'
      progress_size="$((completed / 1048576))/$((total / 1048576)) MiB"
      [[ $heartbeat != true ]] || progress_size="$progress_size; ยังทำงานอยู่ รอข้อมูลจากเครือข่าย"
      case "$phase" in
        connect) printf '\r[BMS] เชื่อมต่อ %-20s %3s%% (%s)' "$component" "$percent" "$progress_size" ;;
        download) printf '\r[BMS] ดาวน์โหลด %-20s %3s%% (%s)' "$component" "$percent" "$progress_size" ;;
        retry) printf '\r[BMS] เครือข่ายหยุด จะลอง %-20s ใหม่ใน %ss (%s)\n' "$component" "$retry_after" "$progress_size" ;;
        cached) printf '\r[BMS] ใช้ไฟล์ที่ดาวน์โหลดแล้ว: %-20s %3s%%\n' "$component" "$percent" ;;
        verify) printf '\r[BMS] ตรวจสอบ %-20s %3s%%' "$component" "$percent" ;;
        staged) printf '\r[BMS] ดาวน์โหลดและตรวจสอบครบ                     100%%\n' ;;
      esac
    fi
  done
}

stage_signed_release() {
  local manifest_uri manifest_dir manifest_path preflight_file target stage_output version test_ca stage_command
  local -a curl_args
  manifest_uri=$(tr -d '\r\n' <"$MANIFEST_URI_FILE")
  is_https_url "$manifest_uri" || die "Manifest URL ใน bootstrap ไม่ปลอดภัย"
  test_ca="$BOOTSTRAP_ROOT/test-release-ca.pem"
  if [[ -f $test_ca ]]; then
    [[ $manifest_uri =~ ^https://(localhost|127\.0\.0\.1|\[::1\])([/:?#]|$) ]] || \
      die "test release CA ใช้ได้เฉพาะ localhost"
    grep -q 'BEGIN CERTIFICATE' "$test_ca" && ! grep -q 'PRIVATE KEY' "$test_ca" || \
      die "test release CA ไม่ถูกต้อง"
    export CURL_CA_BUNDLE="$test_ca" SSL_CERT_FILE="$test_ca"
    note "ใช้ public test CA สำหรับ localhost เท่านั้น (SMOKE-ONLY)"
  fi
  mkdir -p "$STATE_ROOT/manifest"
  chmod 0700 "$STATE_ROOT" "$STATE_ROOT/manifest"
  manifest_dir="$STATE_ROOT/manifest"
  manifest_path="$manifest_dir/release.jws.json"
  note "การติดตั้งครั้งแรกต้องใช้อินเทอร์เน็ต กำลังดาวน์โหลด signed release manifest"
  curl_args=(--fail --location --proto '=https' --tlsv1.2 --max-redirs 5 \
    --connect-timeout 20 --max-time 60 --speed-limit 1 --speed-time 20 \
    --retry 2 --retry-max-time 180 --output "$manifest_path.part")
  [[ ! -f $test_ca ]] || curl_args=(--cacert "$test_ca" "${curl_args[@]}")
  if ! curl "${curl_args[@]}" "$manifest_uri"; then
    die "ดาวน์โหลด release manifest ไม่สำเร็จ กรุณาตรวจอินเทอร์เน็ตแล้วเปิด Setup อีกครั้ง"
  fi
  chmod 0600 "$manifest_path.part"
  mv -f "$manifest_path.part" "$manifest_path"
  preflight_file="$STATE_ROOT/preflight.json"
  "$AGENT" preflight >"$preflight_file"
  target=$(/usr/bin/plutil -extract target raw -o - "$preflight_file" 2>/dev/null || true)
  [[ $target == macos-15-arm64 || $target == macos-15-x64 ]] || die "อ่าน platform target ไม่สำเร็จ"

  stage_output="$STATE_ROOT/stage-result.jsonl"
  : >"$stage_output"
  chmod 0600 "$stage_output"
  note "กำลังดาวน์โหลด component แบบ resume และตรวจ SHA-256 ทุกไฟล์"
  stage_command=stage-release
  [[ $(package_type) != server ]] || stage_command=stage-server
  local -a stage_args=("$stage_command" -manifest "$manifest_path" -keyring "$KEYRING" \
    -target "$target" -root "$STATE_ROOT" -progress)
  [[ ! -f $test_ca ]] || stage_args+=(-test-ca "$test_ca")
  "$AGENT" "${stage_args[@]}" | render_stage_output "$stage_output"
  version=$(tail -n 1 "$stage_output" | /usr/bin/plutil -extract releaseVersion raw -o - - 2>/dev/null || true)
  load_release_paths "$version"
  "$AGENT" verify-release -manifest "$manifest_path" -keyring "$KEYRING" -target "$target" >"$RELEASE_JSON"
  chmod 0600 "$RELEASE_JSON"
}

extract_runtime() {
  local archive destination temporary entry
  archive=$(artifact_path runtime)
  destination="$RUNTIME_ROOT"
  if [[ -x $destination/runtime/lima/bin/limactl && -f $destination/payload/ubuntu-24.04-server-cloudimg.img ]]; then
    return
  fi
  temporary="$destination.partial"
  rm -rf -- "$temporary"
  mkdir -p "$temporary"
  while IFS= read -r entry; do
    [[ -n $entry && $entry != /* && $entry != ../* && $entry != */../* ]] || \
      die "runtime archive มี path ที่ไม่ปลอดภัย"
  done < <(tar -tzf "$archive")
  tar -xzf "$archive" -C "$temporary"
  [[ -x $temporary/runtime/lima/bin/limactl && \
     -f $temporary/payload/ubuntu-24.04-server-cloudimg.img && \
     -f $temporary/payload/runtime/docker.tgz && \
     -x $temporary/payload/runtime/docker-compose && \
     -f $temporary/payload/runtime/age.tar.gz && \
     -f $temporary/payload/bms-localctl ]] || die "runtime component ไม่ครบ"
  rm -rf -- "$destination"
  mv "$temporary" "$destination"
  load_release_paths "$(/usr/bin/plutil -extract releaseVersion raw -o - "$RELEASE_JSON")"
}

render_lima_config() {
  mkdir -p "$STATE_ROOT" "$LIMA_HOME"
  chmod 0700 "$STATE_ROOT" "$LIMA_HOME"
  local platform_target lima_arch
  platform_target=$(cat "$PAYLOAD_ROOT/PLATFORM_TARGET")
  case "$platform_target" in
    macos-15-arm64) lima_arch=aarch64 ;;
    macos-15-x64) lima_arch=x86_64 ;;
    *) die "package target ไม่รองรับ: $platform_target" ;;
  esac

  local image_uri payload escaped_uri escaped_payload ubuntu_sha
  image_uri=$(file_uri "$PAYLOAD_ROOT/ubuntu-24.04-server-cloudimg.img")
  payload=$(yaml_escape_sed "$PAYLOAD_ROOT")
  escaped_uri=$(yaml_escape_sed "$image_uri")
  escaped_payload=$payload
  ubuntu_sha=$(shasum -a 256 "$PAYLOAD_ROOT/ubuntu-24.04-server-cloudimg.img" | awk '{print $1}')
  [[ $ubuntu_sha =~ ^[a-f0-9]{64}$ ]] || die "ไม่พบ checksum ของ Ubuntu runtime"
  [[ $WEB_PORT =~ ^[0-9]{2,5}$ && $WS_PORT =~ ^[0-9]{2,5}$ ]] || die "port ไม่ถูกต้อง"
  sed -e "s|__LIMA_ARCH__|$lima_arch|g" \
      -e "s|__UBUNTU_IMAGE_URI__|$escaped_uri|g" \
      -e "s|__UBUNTU_IMAGE_SHA256__|$ubuntu_sha|g" \
      -e "s|__PAYLOAD_ROOT__|$escaped_payload|g" \
      -e "s|__HOST_WEB_PORT__|$WEB_PORT|g" \
      -e "s|__HOST_WS_PORT__|$WS_PORT|g" \
      "$CONTROL_ROOT/lima.yaml.template" >"$CONFIG.tmp"
  chmod 0600 "$CONFIG.tmp"
  mv -f "$CONFIG.tmp" "$CONFIG"
}

start_setup_vm() {
  local status
  status=$(instance_status)
  if [[ -z $status ]]; then
    note "สร้าง private VM ด้วย Apple Virtualization Framework (ครั้งแรกอาจใช้เวลาหลายนาที)"
    "$LIMACTL" start --name "$INSTANCE" --tty=false --timeout 15m "$CONFIG"
  elif [[ $status != Running ]]; then
    note "เริ่ม private VM"
    "$LIMACTL" start --tty=false --timeout 10m "$INSTANCE"
  fi
}

install_release() {
  local name artifact image_ref digest
  if [[ $INSTALL_MODE == offline ]]; then
    while IFS=$'\t' read -r name artifact image_ref digest; do
      [[ -n $name ]] || continue
      note "โหลด image: $name"
      "$AGENT" engine-load -engine macos-lima -distro "$INSTANCE" \
        -artifact "$PAYLOAD_ROOT/$artifact" -image-ref "$image_ref" -digest "$digest"
    done <"$PAYLOAD_ROOT/release-images.tsv"
  else
    for name in web ws postgres redis; do
      artifact=$(artifact_path "$name")
      image_ref=$(release_component_value "$name" imageRef)
      digest=$(release_component_value "$name" ociDigest)
      note "โหลด image: $name"
      "$AGENT" engine-load -engine macos-lima -distro "$INSTANCE" \
        -artifact "$artifact" -image-ref "$image_ref" -digest "$digest"
    done
  fi

  "$AGENT" runtime-write -engine macos-lima -distro "$INSTANCE" \
    -source "$(artifact_path compose)" \
    -destination /var/lib/bms-retail-local/compose.yml -mode 0600
  "$AGENT" runtime-install-control -engine macos-lima -distro "$INSTANCE" \
    -source "$PAYLOAD_ROOT/bms-localctl" -name bms-localctl

  local web_ref ws_ref postgres_ref redis_ref
  web_ref=$(release_component_value web imageRef)
  ws_ref=$(release_component_value ws imageRef)
  postgres_ref=$(release_component_value postgres imageRef)
  redis_ref=$(release_component_value redis imageRef)
  guest sudo sh -c '
    set -eu
    root=/var/lib/bms-retail-local
    if [ ! -f "$root/.env" ]; then
      umask 077
      random_hex() { od -An -N "$1" -tx1 /dev/urandom | tr -d " \\n"; }
      cat >"$root/.env.pending" <<EOF
POSTGRES_DB=bms_local
POSTGRES_PASSWORD=$(random_hex 24)
REDIS_PASSWORD=$(random_hex 24)
JWT_SECRET=$(random_hex 48)
BMS_SECRET_KEY=$(random_hex 32)
BMS_CHECKOUT_SECRET=$(random_hex 48)
BMS_CRON_SECRET=$(random_hex 32)
BMS_JOB_TOKEN=$(random_hex 32)
BMS_LOCAL_WEB_PORT=3100
BMS_LOCAL_WS_PORT=3101
BMS_WEB_IMAGE_REF=$1
BMS_WS_IMAGE_REF=$2
BMS_POSTGRES_IMAGE_REF=$3
BMS_REDIS_IMAGE_REF=$4
EOF
      sync -f "$root/.env.pending"
      mv -f "$root/.env.pending" "$root/.env"
      sync -f "$root"
    fi
  ' bms-runtime "$web_ref" "$ws_ref" "$postgres_ref" "$redis_ref"
}

shell_export_line() {
  local name=$1 value=$2 encoded
  encoded=$(printf '%s' "$value" | base64 | tr -d '\n')
  printf "export %s=\"\$(printf '%%s' '%s' | base64 -d)\"\n" "$name" "$encoded"
}

select_business_archetype() {
  local manifest choice index=0 default_id default_index=1 id label enabled deprecated
  local -a ids=() labels=()
  manifest=$(artifact_path shop-archetypes)
  [[ -f $manifest ]] || die "signed release ขาด shop-archetypes component"
  default_id=$(/usr/bin/plutil -extract defaultArchetype raw -o - "$manifest" 2>/dev/null || true)
  while id=$(/usr/bin/plutil -extract "archetypes.$index.id" raw -o - "$manifest" 2>/dev/null); do
    enabled=$(/usr/bin/plutil -extract "archetypes.$index.enabledForNewInstall" raw -o - "$manifest" 2>/dev/null || printf 'false')
    deprecated=$(/usr/bin/plutil -extract "archetypes.$index.deprecated" raw -o - "$manifest" 2>/dev/null || printf 'false')
    label=$(/usr/bin/plutil -extract "archetypes.$index.labels.th" raw -o - "$manifest" 2>/dev/null || \
      /usr/bin/plutil -extract "archetypes.$index.labels.en" raw -o - "$manifest" 2>/dev/null || true)
    if [[ $enabled == true && $deprecated != true && $id =~ ^[a-z][a-z0-9_]{1,63}$ && -n $label ]]; then
      ids+=("$id"); labels+=("$label")
      [[ $id != "$default_id" ]] || default_index=${#ids[@]}
    fi
    index=$((index + 1))
  done
  ((${#ids[@]} > 0)) || die "shop-archetypes manifest ไม่มีประเภทร้านที่เปิดให้ติดตั้ง"
  while :; do
    printf '\nประเภทร้าน (ใช้กำหนดหน้าจอ ความสามารถ และสินค้าในข้อมูลตัวอย่าง)\n'
    for index in "${!labels[@]}"; do printf ' %2d) %s\n' "$((index + 1))" "${labels[$index]}"; done
    read -r -p "เลือกประเภทร้าน [$default_index]: " choice
    choice=${choice:-$default_index}
    if [[ $choice =~ ^[0-9]+$ ]] && ((choice >= 1 && choice <= ${#ids[@]})); then
      BUSINESS_ARCHETYPE=${ids[$((choice - 1))]}
      return
    fi
    printf 'กรุณาเลือกหมายเลข 1-%d\n' "${#ids[@]}" >&2
  done
}

select_sample_data() {
  local answer
  while :; do
    read -r -p 'สร้างข้อมูลตัวอย่างตามประเภทร้านนี้หรือไม่? [y/N]: ' answer
    case "$answer" in
      y|Y|yes|YES) SAMPLE_MODE=STARTER_CATALOG; return ;;
      ''|n|N|no|NO) SAMPLE_MODE=NONE; return ;;
      *) printf 'กรุณาตอบ y หรือ n\n' >&2 ;;
    esac
  done
}

collect_shop_details() {
  local password_confirm pin_confirm
  printf '\nข้อมูลร้านแรกเริ่ม (เก็บใน private VM เท่านั้น)\n'
  while [[ -z $SHOP_NAME ]]; do read -r -p 'ชื่อร้าน: ' SHOP_NAME; done
  while [[ -z $ADMIN_NAME ]]; do read -r -p 'ชื่อผู้ดูแลร้าน: ' ADMIN_NAME; done
  while [[ ! $ADMIN_EMAIL =~ ^[^[:space:]@]+@[^[:space:]@]+\.[^[:space:]@]+$ ]]; do
    read -r -p 'อีเมลผู้ดูแลร้าน: ' ADMIN_EMAIL
    [[ $ADMIN_EMAIL =~ ^[^[:space:]@]+@[^[:space:]@]+\.[^[:space:]@]+$ ]] || \
      printf 'อีเมลไม่ถูกต้อง กรุณากรอกใหม่\n' >&2
  done
  select_business_archetype
  select_sample_data
  while :; do
    read -r -s -p 'รหัสผ่านผู้ดูแล (อย่างน้อย 8 ตัวอักษร): ' ADMIN_PASSWORD; printf '\n'
    read -r -s -p 'ยืนยันรหัสผ่านอีกครั้ง: ' password_confirm; printf '\n'
    if [[ ${#ADMIN_PASSWORD} -ge 8 && $ADMIN_PASSWORD == "$password_confirm" ]]; then break; fi
    printf 'รหัสผ่านต้องยาวอย่างน้อย 8 ตัวอักษรและตรงกัน กรุณากรอกใหม่\n' >&2
  done
  while :; do
    read -r -s -p 'PIN ขายหน้าร้าน (ตัวเลข 4-8 หลัก): ' ADMIN_PIN; printf '\n'
    read -r -s -p 'ยืนยัน PIN อีกครั้ง: ' pin_confirm; printf '\n'
    if [[ $ADMIN_PIN =~ ^[0-9]{4,8}$ && $ADMIN_PIN == "$pin_confirm" ]]; then break; fi
    printf 'PIN ต้องเป็นตัวเลข 4-8 หลักและตรงกัน กรุณากรอกใหม่\n' >&2
  done
}

run_sample_data() {
  # This helper is called under `set -e`; skipping optional sample data is a successful path.
  # A bare `[[ ... ]] || return` would return status 1 and abort setup after provisioning.
  case "$PROVISION_SAMPLE_STATUS" in
    PENDING) ;;
    COMPLETED|ALREADY_COMPLETED) return 0 ;;
    *)
      if [[ $SAMPLE_MODE != STARTER_CATALOG ]]; then
        return 0
      fi
      printf '[คำเตือน] ผล provisioning ไม่มีสถานะข้อมูลตัวอย่างที่อ่านได้ กำลังลองสร้างตามตัวเลือกของผู้ใช้\n' >&2
      ;;
  esac
  # provision-result.json is already mode 0600 inside the private VM and contains the one-time
  # token. From this point a sample-data interruption is retryable and cannot lose pairing.
  guest sudo sh -c '
    set -eu
    root=/var/lib/bms-retail-local
    raw="$root/.sample-result.$$"
    json="$root/.sample-result-json.$$"
    trap '\''rm -f "$raw" "$json"'\'' EXIT HUP INT TERM
    cd "$root"
    docker compose --env-file .env -f compose.yml --profile setup run --rm sample-data >"$raw" 2>&1 || true
    if grep -E '\''^\{"status"'\'' "$raw" | tail -n 1 >"$json" && [ -s "$json" ]; then
      :
    else
      printf '\''%s\n'\'' '\''{"status":"FAILED","requested":true,"message":"sample data process did not return a readable result"}'\'' >"$json"
    fi
    install -m 0600 "$json" "$root/sample-result.json"
  ' bms-runtime

  local result_file completed_steps
  result_file="$STATE_ROOT/.sample-result-$(random_suffix).json"
  umask 077
  guest sudo cat /var/lib/bms-retail-local/sample-result.json >"$result_file" 2>/dev/null || true
  PROVISION_SAMPLE_STATUS=$(/usr/bin/plutil -extract status raw -o - "$result_file" 2>/dev/null || printf 'FAILED')
  if [[ $PROVISION_SAMPLE_STATUS =~ ^(COMPLETED|ALREADY_COMPLETED)$ ]]; then
    completed_steps=$(/usr/bin/plutil -extract completedSteps json -o - "$result_file" 2>/dev/null || true)
    if [[ $completed_steps != *'"products"'* ]] || \
       [[ $BUSINESS_ARCHETYPE == restaurant && $completed_steps != *'"restaurant_layout"'* ]]; then
      PROVISION_SAMPLE_STATUS=FAILED
      printf '[คำเตือน] ผลสร้างข้อมูลตัวอย่างไม่ครบตามประเภทร้าน กรุณาลองใหม่จากหน้าเริ่มต้นใช้งาน\n' >&2
    fi
  fi
  rm -f -- "$result_file"
}

provision_shop() {
  if guest sudo test -f /var/lib/bms-retail-local/provision-result.json; then
    note "พบร้านที่ provision แล้ว ดำเนินการ setup ต่อจากครั้งก่อน"
    local checkpoint_file
    checkpoint_file="$STATE_ROOT/.provision-result-$(random_suffix).json"
    umask 077
    guest sudo cat /var/lib/bms-retail-local/provision-result.json >"$checkpoint_file" 2>/dev/null || true
    PROVISION_DEVICE_TOKEN=$(/usr/bin/plutil -extract deviceToken raw -o - "$checkpoint_file" 2>/dev/null) || PROVISION_DEVICE_TOKEN=''
    [[ $PROVISION_DEVICE_TOKEN == pos_* ]] || PROVISION_DEVICE_TOKEN=''
    PROVISION_SAMPLE_STATUS=$(/usr/bin/plutil -extract sampleData.status raw -o - "$checkpoint_file" 2>/dev/null || true)
    SAMPLE_MODE=$(/usr/bin/plutil -extract sampleData.mode raw -o - "$checkpoint_file" 2>/dev/null || printf 'NONE')
    BUSINESS_ARCHETYPE=$(/usr/bin/plutil -extract businessArchetype raw -o - "$checkpoint_file" 2>/dev/null || true)
    PROVISION_TENANT_ID=$(/usr/bin/plutil -extract tenantId raw -o - "$checkpoint_file" 2>/dev/null || true)
    PROVISION_POS_DEVICE_ID=$(/usr/bin/plutil -extract deviceId raw -o - "$checkpoint_file" 2>/dev/null || true)
    rm -f -- "$checkpoint_file"
    run_sample_data
    case "$PROVISION_SAMPLE_STATUS" in
      COMPLETED|ALREADY_COMPLETED) note "สร้างข้อมูลตัวอย่างตามประเภทร้านแล้ว" ;;
      FAILED) printf '[คำแนะนำ] ข้อมูลตัวอย่างยังสร้างไม่ครบ ร้านยังใช้งานได้ และลองใหม่จากหน้าเริ่มต้นใช้งานได้\n' >&2 ;;
    esac
    return
  fi
  [[ -n $SHOP_NAME && -n $ADMIN_NAME && -n $ADMIN_EMAIL && -n $ADMIN_PASSWORD && -n $ADMIN_PIN &&
     -n $BUSINESS_ARCHETYPE && $SAMPLE_MODE =~ ^(NONE|STARTER_CATALOG)$ ]] || \
    die "ข้อมูล setup ไม่ครบ กรุณาเปิด Setup ใหม่"

  local provision_result result_file
  provision_result=$({
    printf '#!/bin/sh\nset -eu\numask 077\n'
    shell_export_line BMS_LOCAL_SHOP_NAME "$SHOP_NAME"
    shell_export_line BMS_LOCAL_SHOP_SLUG local-shop
    shell_export_line BMS_LOCAL_ADMIN_NAME "$ADMIN_NAME"
    shell_export_line BMS_LOCAL_ADMIN_EMAIL "$ADMIN_EMAIL"
    shell_export_line BMS_LOCAL_ADMIN_PASSWORD "$ADMIN_PASSWORD"
    shell_export_line BMS_LOCAL_ADMIN_PIN "$ADMIN_PIN"
    shell_export_line BMS_LOCAL_BUSINESS_ARCHETYPE "$BUSINESS_ARCHETYPE"
    shell_export_line BMS_LOCAL_SAMPLE_MODE "$SAMPLE_MODE"
    cat <<'EOF'
root=/var/lib/bms-retail-local
result="$root/.provision-result.$$"
trap 'rm -f "$result"' EXIT HUP INT TERM
cd "$root"
docker compose --env-file .env -f compose.yml --profile setup run --rm provision >"$result"
grep -E '^\{"status"' "$result" | tail -n 1 >"$root/provision-result.json.pending"
test -s "$root/provision-result.json.pending"
chmod 0600 "$root/provision-result.json.pending"
sync -f "$root/provision-result.json.pending"
mv -f "$root/provision-result.json.pending" "$root/provision-result.json"
sync -f "$root"
install -m 0600 /dev/null "$root/provisioned"
cat "$root/provision-result.json"
EOF
  } | "$LIMACTL" shell "$INSTANCE" sudo sh -s)
  result_file="$STATE_ROOT/.provision-result-$(random_suffix).json"
  umask 077
  printf '%s\n' "$provision_result" | grep -E '^\{"status"' | tail -n 1 >"$result_file"
  PROVISION_DEVICE_TOKEN=$(/usr/bin/plutil -extract deviceToken raw -o - "$result_file" 2>/dev/null) || PROVISION_DEVICE_TOKEN=''
  [[ $PROVISION_DEVICE_TOKEN == pos_* ]] || PROVISION_DEVICE_TOKEN=''
  PROVISION_SAMPLE_STATUS=$(/usr/bin/plutil -extract sampleData.status raw -o - "$result_file" 2>/dev/null || true)
  local reported_sample_mode reported_archetype
  reported_sample_mode=$(/usr/bin/plutil -extract sampleData.mode raw -o - "$result_file" 2>/dev/null || true)
  reported_archetype=$(/usr/bin/plutil -extract businessArchetype raw -o - "$result_file" 2>/dev/null || true)
  [[ ! $reported_sample_mode =~ ^(NONE|STARTER_CATALOG)$ ]] || SAMPLE_MODE=$reported_sample_mode
  [[ -z $reported_archetype ]] || BUSINESS_ARCHETYPE=$reported_archetype
  PROVISION_TENANT_ID=$(/usr/bin/plutil -extract tenantId raw -o - "$result_file" 2>/dev/null || true)
  PROVISION_POS_DEVICE_ID=$(/usr/bin/plutil -extract deviceId raw -o - "$result_file" 2>/dev/null || true)
  rm -f -- "$result_file"
  [[ -z $PROVISION_DEVICE_TOKEN || $PROVISION_DEVICE_TOKEN =~ ^pos_[A-Za-z0-9_-]{16,}$ ]] || \
    die "ผลลัพธ์ pairing token ไม่ถูกต้อง"
  ADMIN_PASSWORD=""; ADMIN_PIN=""
  note "สร้างร้าน ผู้ดูแล สาขา MAIN และเครื่อง POS-01 แล้ว"
  run_sample_data
  case "$PROVISION_SAMPLE_STATUS" in
    COMPLETED|ALREADY_COMPLETED) note "สร้างข้อมูลตัวอย่างตามประเภทร้านแล้ว" ;;
    FAILED) printf '[คำแนะนำ] ข้อมูลตัวอย่างยังสร้างไม่ครบ ร้านยังใช้งานได้ และลองใหม่จากหน้าเริ่มต้นใช้งานได้\n' >&2 ;;
  esac
}

launch_pos_desktop() {
  [[ $(package_type) == server-pos ]] || return
  local pos_app="/Applications/BMS POS.app"
  [[ -d $pos_app ]] || die "ติดตั้ง POS Desktop จาก signed release ไม่สำเร็จ"
  if [[ -n $PROVISION_DEVICE_TOKEN ]]; then
    local expires_at handoff
    expires_at=$(date -v+10M -u '+%Y-%m-%dT%H:%M:%SZ')
    handoff="$STATE_ROOT/pairing-handoff-$(random_suffix).json"
    umask 077
    printf '%s\n' "{\"version\":1,\"serverUrl\":\"http://127.0.0.1:3100\",\"token\":\"$PROVISION_DEVICE_TOKEN\",\"expiresAt\":\"$expires_at\"}" >"$handoff"
    chmod 0600 "$handoff"
    open -a "$pos_app" --args "--pairing-handoff=$handoff"
    PROVISION_DEVICE_TOKEN=""
  else
    open -a "$pos_app"
  fi
}

install_pos_desktop() {
  [[ $INSTALL_MODE == online ]] || return
  [[ $(package_type) == server-pos ]] || return
  local archive temporary app entry
  archive=$(artifact_path desktop)
  temporary="$STATE_ROOT/desktop-install.partial"
  rm -rf -- "$temporary"
  mkdir -p "$temporary"
  while IFS= read -r entry; do
    [[ -n $entry && $entry != /* && $entry != ../* && $entry != */../* ]] || \
      die "desktop archive มี path ที่ไม่ปลอดภัย"
  done < <(/usr/bin/zipinfo -1 "$archive")
  /usr/bin/ditto -x -k "$archive" "$temporary"
  app="$temporary/BMS POS.app"
  [[ -x $app/Contents/MacOS/BMS\ POS && -f $app/Contents/Info.plist ]] || \
    die "desktop component ไม่มี BMS POS.app ที่สมบูรณ์"
  note "ติดตั้ง BMS POS ใน Applications (macOS อาจถามรหัสผ่านผู้ดูแลเครื่อง)"
  sudo /usr/bin/ditto "$app" "/Applications/BMS POS.app"
  sudo chown -R root:wheel "/Applications/BMS POS.app"
  sudo chmod -R go-w "/Applications/BMS POS.app"
  rm -rf -- "$temporary"
}

write_receipt() {
  local version source_commit platform_target schema_version now installed_package_type
  if [[ $INSTALL_MODE == online ]]; then
    version=$(/usr/bin/plutil -extract releaseVersion raw -o - "$RELEASE_JSON")
    source_commit=$(/usr/bin/plutil -extract sourceCommit raw -o - "$RELEASE_JSON")
    platform_target=$(/usr/bin/plutil -extract platformTarget raw -o - "$RELEASE_JSON")
    schema_version=$(/usr/bin/plutil -extract schemaVersion raw -o - "$RELEASE_JSON")
  else
    version=$(cat "$PAYLOAD_ROOT/VERSION")
    source_commit=$(cat "$PAYLOAD_ROOT/SOURCE_COMMIT")
    platform_target=$(cat "$PAYLOAD_ROOT/PLATFORM_TARGET")
    schema_version=""
  fi
  now=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
  installed_package_type=$(package_type)
  umask 077
  rm -f -- "$RECEIPT.tmp"
  /usr/bin/plutil -create xml1 "$RECEIPT.tmp"
  /usr/bin/plutil -insert product -string 'BMS Retail Local' "$RECEIPT.tmp"
  /usr/bin/plutil -insert version -string "$version" "$RECEIPT.tmp"
  /usr/bin/plutil -insert platformTarget -string "$platform_target" "$RECEIPT.tmp"
  /usr/bin/plutil -insert installedAt -string "$now" "$RECEIPT.tmp"
  /usr/bin/plutil -insert updatedAt -string "$now" "$RECEIPT.tmp"
  /usr/bin/plutil -insert sourceCommit -string "$source_commit" "$RECEIPT.tmp"
  /usr/bin/plutil -insert packageType -string "$installed_package_type" "$RECEIPT.tmp"
  /usr/bin/plutil -insert url -string "http://127.0.0.1:$WEB_PORT" "$RECEIPT.tmp"
  [[ -z $schema_version ]] || /usr/bin/plutil -insert schemaVersion -string "$schema_version" "$RECEIPT.tmp"
  [[ -z $PROVISION_TENANT_ID ]] || /usr/bin/plutil -insert tenantId -string "$PROVISION_TENANT_ID" "$RECEIPT.tmp"
  [[ -z $PROVISION_POS_DEVICE_ID ]] || /usr/bin/plutil -insert posDeviceId -string "$PROVISION_POS_DEVICE_ID" "$RECEIPT.tmp"
  [[ -z $BUSINESS_ARCHETYPE ]] || /usr/bin/plutil -insert businessArchetype -string "$BUSINESS_ARCHETYPE" "$RECEIPT.tmp"
  /usr/bin/plutil -insert sampleMode -string "$SAMPLE_MODE" "$RECEIPT.tmp"
  /usr/bin/plutil -insert sampleStatus -string "${PROVISION_SAMPLE_STATUS:-SKIPPED}" "$RECEIPT.tmp"
  [[ -z $LICENSE_ID ]] || /usr/bin/plutil -insert licenseCode -string "$LICENSE_ID" "$RECEIPT.tmp"
  /usr/bin/plutil -convert json "$RECEIPT.tmp"
  chmod 0600 "$RECEIPT.tmp"
  "$AGENT" runtime-write -engine macos-lima -distro "$INSTANCE" -source "$RECEIPT.tmp" \
    -destination /var/lib/bms-retail-local/installation.json -mode 0600
  mv -f "$RECEIPT.tmp" "$RECEIPT"
}

record_license_evidence() {
  [[ -n $LICENSE_ID ]] || return 0
  local version platform_target output
  if [[ $INSTALL_MODE == online ]]; then
    version=$(/usr/bin/plutil -extract releaseVersion raw -o - "$RELEASE_JSON")
    platform_target=$(/usr/bin/plutil -extract platformTarget raw -o - "$RELEASE_JSON")
  else
    version=$(cat "$PAYLOAD_ROOT/VERSION")
    platform_target=$(cat "$PAYLOAD_ROOT/PLATFORM_TARGET")
  fi
  local -a arguments=(license-record -root "$STATE_ROOT" -event INSTALLATION_REGISTERED
    -license-id "$LICENSE_ID" -target "$platform_target" -release-version "$version")
  [[ -z $PROVISION_TENANT_ID ]] || arguments+=(-tenant-id "$PROVISION_TENANT_ID")
  [[ -z $PROVISION_POS_DEVICE_ID ]] || arguments+=(-pos-device-id "$PROVISION_POS_DEVICE_ID")
  [[ -z $LICENSE_EVIDENCE_ENDPOINT ]] || arguments+=(-endpoint "$LICENSE_EVIDENCE_ENDPOINT")
  if ! output=$(BMS_LICENSE_EVIDENCE_TOKEN="$LICENSE_EVIDENCE_TOKEN" "$AGENT" "${arguments[@]}" 2>&1); then
    printf '[คำเตือน] เก็บหลักฐาน Licensing ไม่สำเร็จ แต่ร้านยังใช้งานต่อได้: %s\n' "$output" >&2
    return 0
  fi
  rm -f -- "$STATE_ROOT/activation.json"
}

pulse_license_evidence() {
  [[ -d $STATE_ROOT/license-evidence ]] || return 0
  "$AGENT" license-pulse -root "$STATE_ROOT" >/dev/null 2>&1 || true
}

render_launch_agent() {
  mkdir -p "$HOME/Library/LaunchAgents" "$STATE_ROOT"
  local control log
  control=$(yaml_escape_sed "$SYSTEM_ROOT/control/bms-retail-local")
  log=$(yaml_escape_sed "$LOG_PATH")
  sed -e "s|__HOST_CONTROL__|$control|g" -e "s|__LOG_PATH__|$log|g" \
    "$CONTROL_ROOT/com.bms.retail-local.plist.template" >"$LAUNCH_AGENT.tmp"
  plutil -lint "$LAUNCH_AGENT.tmp" >/dev/null
  chmod 0600 "$LAUNCH_AGENT.tmp"
  mv -f "$LAUNCH_AGENT.tmp" "$LAUNCH_AGENT"
}

install_license_ui_agent() {
  [[ $INSTALL_MODE == online && -s $BOOTSTRAP_ROOT/activation-url ]] || return 0
  mkdir -p "$HOME/Library/LaunchAgents"
  local temporary="$LICENSE_UI_AGENT.tmp"
  rm -f -- "$temporary"
  /usr/bin/plutil -create xml1 "$temporary"
  /usr/bin/plutil -insert Label -string com.bms.retail-local.license-ui "$temporary"
  /usr/bin/plutil -insert ProgramArguments -array "$temporary"
  /usr/bin/plutil -insert ProgramArguments.0 -string "$CONTROL_ROOT/bms-retail-local" "$temporary"
  /usr/bin/plutil -insert ProgramArguments.1 -string license-ui "$temporary"
  /usr/bin/plutil -insert StartInterval -integer 30 "$temporary"
  /usr/bin/plutil -insert RunAtLoad -bool YES "$temporary"
  chmod 0600 "$temporary"
  mv -f "$temporary" "$LICENSE_UI_AGENT"
  launchctl bootout "gui/$(id -u)" "$LICENSE_UI_AGENT" >/dev/null 2>&1 || true
  launchctl bootstrap "gui/$(id -u)" "$LICENSE_UI_AGENT"
}

poll_license_ui() {
  [[ -f $RECEIPT ]] || return 0
  load_installed_release
  [[ $INSTALL_MODE == online && $(instance_status) == Running ]] || return 0
  "$AGENT" license-ui -root "$STATE_ROOT" -engine macos-lima -distro "$INSTANCE" \
    -activation-uri "$(tr -d '\r\n' < "$BOOTSTRAP_ROOT/activation-url")"
}

install_launch_agent() {
  render_launch_agent
  launchctl bootout "gui/$(id -u)" "$LAUNCH_AGENT" >/dev/null 2>&1 || true
  launchctl bootstrap "gui/$(id -u)" "$LAUNCH_AGENT"
  launchctl kickstart -k "$LAUNCH_LABEL"
  install_license_ui_agent || note "ยังตั้งระบบลงทะเบียนผ่าน Admin ไม่สำเร็จ ร้านยังใช้งานได้"
}

http_ready() {
  curl --fail --silent --max-time 5 "http://127.0.0.1:$WEB_PORT/admin/login" >/dev/null && \
    curl --fail --silent --max-time 5 "http://127.0.0.1:$WS_PORT/readyz" >/dev/null
}

wait_for_http() {
  local deadline=$((SECONDS + 300))
  until http_ready; do
    (( SECONDS < deadline )) || die "บริการไม่ผ่าน HTTP health check ดู log ด้วย: bms-retail-local logs"
    sleep 3
  done
}

ensure_runtime() {
  load_installed_release
  require_installed_payload
  if http_ready; then
    note "Retail Local ทำงานอยู่แล้ว"
    return
  fi
  render_launch_agent
  if launchctl print "$LAUNCH_LABEL" >/dev/null 2>&1; then
    # Do not use -k here: a second POS launch must not kill a VM that is already booting.
    launchctl kickstart "$LAUNCH_LABEL"
  else
    launchctl bootstrap "gui/$(id -u)" "$LAUNCH_AGENT"
    launchctl kickstart "$LAUNCH_LABEL"
  fi
  wait_for_http
  note "พร้อมใช้งาน: http://127.0.0.1:$WEB_PORT"
  pulse_license_evidence
}

wait_for_guest_doctor() {
  local deadline=$((SECONDS + 300))
  until guest sudo /usr/local/bin/bms-localctl doctor >/dev/null 2>&1; do
    if (( SECONDS >= deadline )); then
      guest sudo /usr/local/bin/bms-localctl status || true
      die "บริการใน private VM ไม่ผ่าน health check ดู log ด้วย: bms-retail-local logs"
    fi
    sleep 3
  done
  guest sudo /usr/local/bin/bms-localctl doctor
}

setup_runtime() {
  require_bootstrap
  if [[ -f $RECEIPT ]]; then
    # The receipt precedes launch-agent registration; a reboot may interrupt that last step.
    ensure_runtime
    install_license_ui_agent || true
    wait_for_guest_doctor
    if guest sudo test -f /var/lib/bms-retail-local/provision-result.json; then
      provision_shop
    fi
    launch_pos_desktop
    guest sudo rm -f /var/lib/bms-retail-local/provision-result.json /var/lib/bms-retail-local/sample-result.json
    note "ติดตั้งแล้วและพร้อมใช้งาน ข้อมูลร้านเดิมถูกเก็บไว้"
    return
  fi
  require_matching_mac_architecture
  mkdir -p "$STATE_ROOT"
  chmod 0700 "$STATE_ROOT"
  step 1 "ตรวจสอบ macOS, CPU, RAM, Virtualization และพื้นที่ว่าง"
  note "ติดตั้งและทดลองใช้งานได้ทันทีโดยไม่ต้องมี Activation Code"
  "$AGENT" preflight --human || die "ยังติดตั้งไม่ได้ กรุณาแก้ไขรายการ preflight ด้านบนแล้วเปิด BMS Retail Local อีกครั้ง"
  activate_license
  if [[ $INSTALL_MODE == online ]]; then
    step 2 "ดาวน์โหลดและตรวจสอบ signed release"
    stage_signed_release
    extract_runtime
  else
    step 2 "ตรวจสอบไฟล์ Offline Recovery Installer"
    verify_embedded_payload
  fi
  require_installed_payload
  render_lima_config
  step 3 "เตรียม private runtime"
  start_setup_vm
  if ! guest sudo test -f /var/lib/bms-retail-local/provisioned; then
    step 4 "รับข้อมูลร้านและผู้ดูแล"
    collect_shop_details
  else
    step 4 "พบข้อมูลร้านเดิม กำลังติดตั้งต่อจากจุดที่ค้าง"
  fi
  step 5 "ติดตั้ง Web, WS, PostgreSQL และ Redis"
  install_release
  provision_shop
  step 6 "เริ่มบริการและตรวจสุขภาพระบบ"
  guest sudo /usr/local/bin/bms-localctl start
  wait_for_http
  wait_for_guest_doctor
  install_pos_desktop
  write_receipt
  if [[ $INSTALL_MODE == online && -s $BOOTSTRAP_ROOT/activation-url ]]; then
    "$AGENT" installation-report -root "$STATE_ROOT" \
      -control-uri "$(tr -d '\r\n' < "$BOOTSTRAP_ROOT/activation-url")" -event INSTALLED \
      -package-type "$(/usr/bin/plutil -extract packageType raw -o - "$RECEIPT")" \
      -target "$(/usr/bin/plutil -extract platformTarget raw -o - "$RECEIPT")" \
      -release-version "$(/usr/bin/plutil -extract version raw -o - "$RECEIPT")" \
      -tenant-reference "$PROVISION_TENANT_ID" -license-reference "$LICENSE_ID" -force \
      >/dev/null 2>&1 || note "ส่งข้อมูลการติดตั้งขั้นต่ำไม่สำเร็จ; ระบบจะลองใหม่ภายหลัง"
  fi
  record_license_evidence
  if [[ ${BMS_RETAIL_LOCAL_TEST_MODE:-0} != 1 ]]; then
    "$LIMACTL" stop "$INSTANCE"
    install_launch_agent
    wait_for_http
    launch_pos_desktop
  fi
  guest sudo rm -f /var/lib/bms-retail-local/provision-result.json /var/lib/bms-retail-local/sample-result.json
  step 7 "ติดตั้งสำเร็จ"
  note "พร้อมใช้งาน: http://127.0.0.1:$WEB_PORT"
  note "ทดลองใช้งานได้ทันทีโดยไม่ต้องมี Activation Code"
  if [[ $INSTALL_MODE == online && -s $BOOTSTRAP_ROOT/activation-url ]]; then
    note "หากได้รับ Code จาก BMS ให้ลงทะเบียนภายหลัง: Admin > License ของเครื่องนี้ หรือ bms-retail-local activate"
  fi
}

start_runtime() {
  ensure_runtime
  install_license_ui_agent || true
}

stop_runtime() {
  [[ ! -f $RECEIPT ]] || load_installed_release
  launchctl bootout "gui/$(id -u)" "$LAUNCH_AGENT" >/dev/null 2>&1 || true
  launchctl bootout "gui/$(id -u)" "$LICENSE_UI_AGENT" >/dev/null 2>&1 || true
  if [[ $(instance_status) == Running ]]; then "$LIMACTL" stop "$INSTANCE"; fi
  note "หยุด Retail Local แล้ว"
}

uninstall_runtime() {
  local erase_data=false confirmation="" remove_pos=true
  while (($#)); do
    case "$1" in
      --erase-data) erase_data=true; shift ;;
      --confirm) confirmation=${2:-}; shift 2 ;;
      *) die "usage: bms-retail-local uninstall [--erase-data --confirm ERASE-BMS-RETAIL-LOCAL]" ;;
    esac
  done

  if [[ ${EUID:-$(id -u)} -eq 0 && -z ${BMS_RETAIL_LOCAL_ALLOW_ROOT_UNINSTALL:-} ]]; then
    die "อย่ารัน uninstall ด้วย sudo โดยตรง เพราะข้อมูลร้านอยู่ใต้ user ที่ setup ให้รันแบบ user ปกติ"
  fi

  [[ ! -f $RECEIPT ]] || load_installed_release
  if [[ $(package_type) != server-pos ]]; then
    remove_pos=false
  fi

  uninstall_step 1 "ปิดการเริ่มอัตโนมัติ"
  rm -f -- "$LAUNCH_AGENT"
  run_with_timeout 5 launchctl bootout "gui/$(id -u)/com.bms.retail-local.license-ui" >/dev/null 2>&1 || true
  rm -f -- "$LICENSE_UI_AGENT"
  run_with_timeout 5 launchctl bootout "$LAUNCH_LABEL" >/dev/null 2>&1 || true

  uninstall_step 2 "บันทึกการถอนการติดตั้งและหยุด private VM"
  if [[ -x $AGENT && -d $STATE_ROOT/license-evidence ]]; then
    run_with_timeout 3 "$AGENT" license-pulse -root "$STATE_ROOT" \
      -event INSTALLATION_DEACTIVATED >/dev/null 2>&1 || true
  fi
  if [[ -x $AGENT && -f $RECEIPT && -s $BOOTSTRAP_ROOT/activation-url ]]; then
    run_with_timeout 5 "$AGENT" installation-report -root "$STATE_ROOT" \
      -control-uri "$(tr -d '\r\n' < "$BOOTSTRAP_ROOT/activation-url")" -event UNINSTALLED \
      -package-type "$(/usr/bin/plutil -extract packageType raw -o - "$RECEIPT")" \
      -target "$(/usr/bin/plutil -extract platformTarget raw -o - "$RECEIPT")" \
      -release-version "$(/usr/bin/plutil -extract version raw -o - "$RECEIPT")" \
      -tenant-reference "$(/usr/bin/plutil -extract tenantId raw -o - "$RECEIPT" 2>/dev/null || true)" \
      -license-reference "$(/usr/bin/plutil -extract licenseCode raw -o - "$RECEIPT" 2>/dev/null || true)" \
      -force >/dev/null 2>&1 || true
  fi
  if [[ -x $LIMACTL && -d $LIMA_HOME/$INSTANCE ]]; then
    if ! run_with_timeout 10 "$LIMACTL" stop "$INSTANCE" >/dev/null 2>&1; then
      printf '[คำเตือน] private VM หยุดไม่ทัน 10 วินาที กำลังดำเนินการถอน startup ต่อ\n' >&2
    fi
  fi

  if [[ $erase_data != true ]]; then
    uninstall_step 3 "เก็บข้อมูลร้านและ private VM สำหรับ recovery"
    uninstall_step 4 "เสร็จสิ้น"
    note "หยุดและถอด startup แล้ว"
    note "ข้อมูลร้าน, private VM และ secrets ยังอยู่ใน: $STATE_ROOT"
    note "ใช้ bms-retail-local backup ก่อน และใช้ uninstall --erase-data เฉพาะเมื่อต้องการลบถาวร"
    return
  fi

  if [[ -z $confirmation ]]; then
    read -r -p 'การลบถาวรกู้คืนไม่ได้ พิมพ์ ERASE-BMS-RETAIL-LOCAL: ' confirmation
  fi
  [[ $confirmation == ERASE-BMS-RETAIL-LOCAL ]] || die "ยกเลิกการลบข้อมูล"

  uninstall_step 3 "ลบ private VM และข้อมูลร้าน"
  if [[ -x $LIMACTL && -d $LIMA_HOME/$INSTANCE ]]; then
    run_with_timeout 60 "$LIMACTL" delete -f "$INSTANCE" >/dev/null 2>&1 || \
      die "ลบ private VM ไม่สำเร็จ จึงยังไม่ลบข้อมูลร้าน กรุณาลองใหม่หรือติดต่อ Support"
  fi
  rm -rf -- "$STATE_ROOT" "$LIMA_HOME"
  sudo rm -rf -- "$SYSTEM_ROOT" "/Applications/BMS Retail Local.app"
  [[ $remove_pos != true ]] || sudo rm -rf -- "/Applications/BMS POS.app"
  sudo rm -f -- "/Applications/BMS Retail Local Uninstall.command"
  sudo rm -f -- /usr/local/bin/bms-retail-local
  sudo pkgutil --forget com.base2526.bms.retail-local >/dev/null 2>&1 || true
  uninstall_step 4 "ลบระบบและข้อมูลร้านแล้ว"
  note "ลบ BMS Retail Local และข้อมูลในเครื่องแล้ว"
}

show_status() {
  load_installed_release
  require_installed_payload
  if [[ $INSTALL_MODE == online ]]; then
    printf 'Version: %s\n' "$(/usr/bin/plutil -extract releaseVersion raw -o - "$RELEASE_JSON")"
  else
    printf 'Version: %s\n' "$(cat "$PAYLOAD_ROOT/VERSION")"
  fi
  printf 'Runtime: %s\n' "$(instance_status | sed 's/^$/Not created/')"
  if [[ $(instance_status) == Running ]]; then
    guest sudo /usr/local/bin/bms-localctl status
  fi
}

doctor() {
  load_installed_release
  require_installed_payload
  [[ $(instance_status) == Running ]] || die "runtime ไม่ได้ทำงาน"
  guest sudo /usr/local/bin/bms-localctl doctor
  curl --fail --silent --max-time 5 "http://127.0.0.1:$WEB_PORT/admin/login" >/dev/null
  curl --fail --silent --max-time 5 "http://127.0.0.1:$WS_PORT/readyz" >/dev/null
  note "host forwarding: healthy"
}

backup_runtime() {
  local output=${1:-} recipient=${2:-}
  load_installed_release
  require_installed_payload
  [[ -n $output && $recipient =~ ^age1[0-9a-z]{58}$ ]] || \
    die "usage: bms-retail-local backup OUTPUT.age AGE_RECIPIENT"
  [[ $(instance_status) == Running ]] || die "runtime ไม่ได้ทำงาน"
  [[ ! -e $output ]] || die "ไฟล์ปลายทางมีอยู่แล้ว"
  local name guest_path temporary
  name="backup-$(date -u '+%Y%m%dT%H%M%SZ')-$(random_suffix).age"
  guest_path="/var/lib/bms-retail-local/backups/$name"
  temporary="$output.part"
  guest sudo /usr/local/bin/bms-localctl backup "$guest_path" --recipient "$recipient"
  "$LIMACTL" copy --backend=scp "$INSTANCE:$guest_path" "$temporary"
  chmod 0600 "$temporary"
  mv "$temporary" "$output"
  guest sudo sh -c 'rm -f -- "$1"' bms-runtime "$guest_path"
  shasum -a 256 "$output" >"$output.sha256"
  note "backup พร้อม: $output"
}

host_service() {
  [[ -f $RECEIPT ]] || exit 0
  load_installed_release
  require_installed_payload
  exec "$LIMACTL" start --foreground --tty=false --timeout 10m "$INSTANCE"
}

case "${1:-}" in
  setup)
    # shellcheck source=../setup-diagnostics.sh
    source "$CONTROL_ROOT/setup-diagnostics.sh"
    bms_diagnostics_init "$(package_type)" "$STATE_ROOT" "$CONTROL_ROOT/BOOTSTRAP_VERSION"
    trap 'status=$?; trap - EXIT ERR; bms_diagnostics_finish "$status"; exit "$status"' EXIT
    trap 'exit 130' HUP INT TERM
    setup_runtime
    ;;
  start) start_runtime ;;
  activate) shift; activate_installed_license "$@" ;;
  license-ui) poll_license_ui ;;
  ensure-running) ensure_runtime ;;
  stop) stop_runtime ;;
  restart) stop_runtime; start_runtime ;;
  uninstall) shift; uninstall_runtime "$@" ;;
  status) show_status ;;
  doctor) doctor ;;
  backup) shift; backup_runtime "$@" ;;
  logs)
    load_installed_release
    tail -n 160 "$LOG_PATH" 2>/dev/null || true
    [[ $(instance_status) == Running ]] && guest sudo sh -c 'cd /var/lib/bms-retail-local && docker compose --env-file .env -f compose.yml logs --tail=160' || true
    ;;
  open) open "http://127.0.0.1:$WEB_PORT/admin/login" ;;
  host-service) host_service ;;
  *)
    die "usage: bms-retail-local <setup|activate|start|ensure-running|stop|restart|uninstall|status|doctor|backup|logs|open>"
    ;;
esac
