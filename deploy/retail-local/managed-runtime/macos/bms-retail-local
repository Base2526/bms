#!/bin/bash
set -Eeuo pipefail

readonly SYSTEM_ROOT="${BMS_RETAIL_LOCAL_SYSTEM_ROOT:-/Library/Application Support/BMS/RetailLocal}"
readonly PAYLOAD_ROOT="$SYSTEM_ROOT/payload"
readonly CONTROL_ROOT="$SYSTEM_ROOT/control"
readonly STATE_ROOT="${BMS_RETAIL_LOCAL_STATE_ROOT:-$HOME/Library/Application Support/BMS/RetailLocal}"
readonly LIMA_HOME="${BMS_RETAIL_LOCAL_LIMA_HOME:-$HOME/.bmsrl}"
readonly INSTANCE="${BMS_RETAIL_LOCAL_INSTANCE:-bms-retail-local}"
readonly WEB_PORT="${BMS_RETAIL_LOCAL_HOST_WEB_PORT:-3100}"
readonly WS_PORT="${BMS_RETAIL_LOCAL_HOST_WS_PORT:-3101}"
readonly LIMACTL="$SYSTEM_ROOT/runtime/lima/bin/limactl"
readonly AGENT="$PAYLOAD_ROOT/bin/bms-runtime-agent"
readonly RECEIPT="$STATE_ROOT/installation.json"
readonly CONFIG="$STATE_ROOT/lima.yaml"
readonly ARCH_FILE="$PAYLOAD_ROOT/ARCH"
readonly LAUNCH_AGENT="$HOME/Library/LaunchAgents/com.bms.retail-local.plist"
readonly LOG_PATH="$STATE_ROOT/host-service.log"
PROVISION_DEVICE_TOKEN=""
PROVISION_SAMPLE_STATUS=""
SHOP_NAME=""
ADMIN_NAME=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_PIN=""
BUSINESS_ARCHETYPE=""
CREATE_SAMPLE_DATA="0"
LAUNCH_LABEL="gui/$(id -u)/com.bms.retail-local"
readonly LAUNCH_LABEL

export LIMA_HOME BMS_LIMACTL_PATH="$LIMACTL"
export PATH="$SYSTEM_ROOT/runtime/lima/bin:$SYSTEM_ROOT/runtime/lima/libexec:/usr/bin:/bin:/usr/sbin:/sbin"

die() { printf 'BMS Retail Local: %s\n' "$*" >&2; exit 1; }
note() { printf '[BMS] %s\n' "$*"; }
step() { printf '\n[BMS %s/7] %s\n' "$1" "$2"; }
require_installed_payload() {
  [[ -x $LIMACTL && -x $AGENT && -f $PAYLOAD_ROOT/SHA256SUMS ]] || \
    die "ไฟล์ติดตั้งไม่ครบ กรุณาติดตั้ง .pkg ใหม่"
}
instance_status() {
  "$LIMACTL" list "$INSTANCE" --format '{{.Status}}' 2>/dev/null | tr -d '\r' || true
}
guest() { "$LIMACTL" shell "$INSTANCE" "$@"; }
yaml_escape_sed() { printf '%s' "$1" | sed -e 's/[&|]/\\&/g'; }
# Lima's local file fetcher opens the literal file:// path and does not URL-decode %20.
file_uri() { printf 'file://%s' "$1"; }
random_suffix() { od -An -N 6 -tx1 /dev/urandom | tr -d ' \n'; }

verify_payload() {
  note "ตรวจ checksum ของ runtime และ server images"
  (cd "$PAYLOAD_ROOT" && shasum -a 256 -c SHA256SUMS >/dev/null) || \
    die "checksum ของไฟล์ใน installer ไม่ถูกต้อง"
}

render_lima_config() {
  mkdir -p "$STATE_ROOT" "$LIMA_HOME"
  chmod 0700 "$STATE_ROOT" "$LIMA_HOME"
  local package_arch lima_arch ubuntu_image docker_archive compose_binary age_archive
  package_arch=$(cat "$ARCH_FILE" 2>/dev/null || printf 'arm64')
  case "$package_arch" in
    arm64)
      lima_arch=aarch64
      ubuntu_image=ubuntu-24.04-server-cloudimg-arm64.img
      docker_archive=docker-aarch64.tgz
      compose_binary=docker-compose-linux-aarch64
      age_archive=age-linux-arm64.tar.gz
      ;;
    x64)
      lima_arch=x86_64
      ubuntu_image=ubuntu-24.04-server-cloudimg-amd64.img
      docker_archive=docker-x86_64.tgz
      compose_binary=docker-compose-linux-x86_64
      age_archive=age-linux-amd64.tar.gz
      ;;
    *) die "package arch ไม่รองรับ: $package_arch" ;;
  esac

  local image_uri payload escaped_uri escaped_payload ubuntu_sha
  image_uri=$(file_uri "$PAYLOAD_ROOT/$ubuntu_image")
  payload=$(yaml_escape_sed "$PAYLOAD_ROOT")
  escaped_uri=$(yaml_escape_sed "$image_uri")
  escaped_payload=$payload
  ubuntu_sha=$(awk -v image="./$ubuntu_image" '$2 == image {print $1}' "$PAYLOAD_ROOT/SHA256SUMS")
  [[ $ubuntu_sha =~ ^[a-f0-9]{64}$ ]] || die "ไม่พบ checksum ของ Ubuntu runtime"
  [[ $WEB_PORT =~ ^[0-9]{2,5}$ && $WS_PORT =~ ^[0-9]{2,5}$ ]] || die "port ไม่ถูกต้อง"
  sed -e "s|__LIMA_ARCH__|$lima_arch|g" \
      -e "s|__UBUNTU_IMAGE_URI__|$escaped_uri|g" \
      -e "s|__UBUNTU_IMAGE_SHA256__|$ubuntu_sha|g" \
      -e "s|__PAYLOAD_ROOT__|$escaped_payload|g" \
      -e "s|__HOST_WEB_PORT__|$WEB_PORT|g" \
      -e "s|__HOST_WS_PORT__|$WS_PORT|g" \
      -e "s|__DOCKER_ARCHIVE__|$docker_archive|g" \
      -e "s|__COMPOSE_BINARY__|$compose_binary|g" \
      -e "s|__AGE_ARCHIVE__|$age_archive|g" \
      "$CONTROL_ROOT/lima.yaml.template" >"$CONFIG.tmp"
  chmod 0600 "$CONFIG.tmp"
  mv -f "$CONFIG.tmp" "$CONFIG"
}

start_setup_vm() {
  local status
  status=$(instance_status)
  if [[ -z $status ]]; then
    note "สร้าง private VM ด้วย Apple Virtualization Framework (ครั้งแรกอาจใช้เวลาหลายนาที)"
    "$LIMACTL" start --name "$INSTANCE" --tty=false --timeout 15m "$CONFIG"
  elif [[ $status != Running ]]; then
    note "เริ่ม private VM"
    "$LIMACTL" start --tty=false --timeout 10m "$INSTANCE"
  fi
}

install_release() {
  local name artifact image_ref digest
  while IFS=$'\t' read -r name artifact image_ref digest; do
    [[ -n $name ]] || continue
    note "โหลด image: $name"
    "$AGENT" engine-load -engine macos-lima -distro "$INSTANCE" \
      -artifact "$PAYLOAD_ROOT/$artifact" -image-ref "$image_ref" -digest "$digest"
  done <"$PAYLOAD_ROOT/release-images.tsv"

  "$AGENT" runtime-write -engine macos-lima -distro "$INSTANCE" \
    -source "$PAYLOAD_ROOT/compose.artifact" \
    -destination /var/lib/bms-retail-local/compose.yml -mode 0600
  "$AGENT" runtime-install-control -engine macos-lima -distro "$INSTANCE" \
    -source "$PAYLOAD_ROOT/bms-localctl" -name bms-localctl

  local web_ref ws_ref postgres_ref redis_ref
  web_ref=$(awk -F '\t' '$1 == "web" {print $3}' "$PAYLOAD_ROOT/release-images.tsv")
  ws_ref=$(awk -F '\t' '$1 == "ws" {print $3}' "$PAYLOAD_ROOT/release-images.tsv")
  postgres_ref=$(awk -F '\t' '$1 == "postgres" {print $3}' "$PAYLOAD_ROOT/release-images.tsv")
  redis_ref=$(awk -F '\t' '$1 == "redis" {print $3}' "$PAYLOAD_ROOT/release-images.tsv")
  guest sudo sh -c '
    set -eu
    root=/var/lib/bms-retail-local
    if [ ! -f "$root/.env" ]; then
      umask 077
      random_hex() { od -An -N "$1" -tx1 /dev/urandom | tr -d " \\n"; }
      cat >"$root/.env" <<EOF
POSTGRES_DB=bms_local
POSTGRES_PASSWORD=$(random_hex 24)
REDIS_PASSWORD=$(random_hex 24)
JWT_SECRET=$(random_hex 48)
BMS_SECRET_KEY=$(random_hex 32)
BMS_CHECKOUT_SECRET=$(random_hex 48)
BMS_CRON_SECRET=$(random_hex 32)
BMS_JOB_TOKEN=$(random_hex 32)
BMS_LOCAL_WEB_PORT=3100
BMS_LOCAL_WS_PORT=3101
BMS_WEB_IMAGE_REF=$1
BMS_WS_IMAGE_REF=$2
BMS_POSTGRES_IMAGE_REF=$3
BMS_REDIS_IMAGE_REF=$4
EOF
    fi
  ' bms-runtime "$web_ref" "$ws_ref" "$postgres_ref" "$redis_ref"
}

shell_export_line() {
  local name=$1 value=$2 encoded
  encoded=$(printf '%s' "$value" | base64 | tr -d '\n')
  printf "export %s=\"\$(printf '%%s' '%s' | base64 -d)\"\n" "$name" "$encoded"
}

select_business_archetype() {
  local choice
  while :; do
    cat <<'EOF'

ประเภทร้าน (ใช้กำหนดหน้าจอ ความสามารถ และสินค้าในข้อมูลตัวอย่าง)
  1) ร้านสะดวกซื้อ / ร้านขายของชำ
  2) แฟชั่นและเสื้อผ้า
  3) บ้านและเครื่องครัว
  4) ความงามและของใช้ส่วนตัว
  5) อาหารและเครื่องดื่มพร้อมขาย
  6) อุปกรณ์ไอทีและแกดเจ็ต
  7) ค้าส่ง / B2B
  8) ของขวัญและสินค้าตามเทศกาล
  9) ร้านยา
 10) ร้านอุปกรณ์สัตว์เลี้ยง
 11) ร้านวัสดุก่อสร้าง
 12) ร้านอาหาร / ระบบครัว
 13) คาเฟ่บอร์ดเกม
 14) ร้านประเภทอื่น
EOF
    read -r -p 'เลือกประเภทร้าน 1-14: ' choice
    case "$choice" in
      1) BUSINESS_ARCHETYPE=mini_mart ;;
      2) BUSINESS_ARCHETYPE=fashion ;;
      3) BUSINESS_ARCHETYPE=home_kitchen ;;
      4) BUSINESS_ARCHETYPE=beauty_personal_care ;;
      5) BUSINESS_ARCHETYPE=food_beverage ;;
      6) BUSINESS_ARCHETYPE=gadgets_accessories ;;
      7) BUSINESS_ARCHETYPE=b2b_wholesale ;;
      8) BUSINESS_ARCHETYPE=gifts_seasonal ;;
      9) BUSINESS_ARCHETYPE=pharmacy ;;
      10) BUSINESS_ARCHETYPE=pet_supply ;;
      11) BUSINESS_ARCHETYPE=building_materials ;;
      12) BUSINESS_ARCHETYPE=restaurant ;;
      13) BUSINESS_ARCHETYPE=board_game_cafe ;;
      14) BUSINESS_ARCHETYPE=other ;;
      *) printf 'กรุณาเลือกหมายเลข 1-14\n' >&2; continue ;;
    esac
    break
  done
}

select_sample_data() {
  local answer
  while :; do
    read -r -p 'สร้างข้อมูลตัวอย่างตามประเภทร้านนี้หรือไม่? [y/N]: ' answer
    case "$answer" in
      y|Y|yes|YES) CREATE_SAMPLE_DATA=1; return ;;
      ''|n|N|no|NO) CREATE_SAMPLE_DATA=0; return ;;
      *) printf 'กรุณาตอบ y หรือ n\n' >&2 ;;
    esac
  done
}

collect_shop_details() {
  local password_confirm pin_confirm
  printf '\nข้อมูลร้านแรกเริ่ม (เก็บใน private VM เท่านั้น)\n'
  while [[ -z $SHOP_NAME ]]; do read -r -p 'ชื่อร้าน: ' SHOP_NAME; done
  while [[ -z $ADMIN_NAME ]]; do read -r -p 'ชื่อผู้ดูแลร้าน: ' ADMIN_NAME; done
  while [[ ! $ADMIN_EMAIL =~ ^[^[:space:]@]+@[^[:space:]@]+\.[^[:space:]@]+$ ]]; do
    read -r -p 'อีเมลผู้ดูแลร้าน: ' ADMIN_EMAIL
    [[ $ADMIN_EMAIL =~ ^[^[:space:]@]+@[^[:space:]@]+\.[^[:space:]@]+$ ]] || \
      printf 'อีเมลไม่ถูกต้อง กรุณากรอกใหม่\n' >&2
  done
  select_business_archetype
  select_sample_data
  while :; do
    read -r -s -p 'รหัสผ่านผู้ดูแล (อย่างน้อย 8 ตัวอักษร): ' ADMIN_PASSWORD; printf '\n'
    read -r -s -p 'ยืนยันรหัสผ่านอีกครั้ง: ' password_confirm; printf '\n'
    if [[ ${#ADMIN_PASSWORD} -ge 8 && $ADMIN_PASSWORD == "$password_confirm" ]]; then break; fi
    printf 'รหัสผ่านต้องยาวอย่างน้อย 8 ตัวอักษรและตรงกัน กรุณากรอกใหม่\n' >&2
  done
  while :; do
    read -r -s -p 'PIN ขายหน้าร้าน (ตัวเลข 4-8 หลัก): ' ADMIN_PIN; printf '\n'
    read -r -s -p 'ยืนยัน PIN อีกครั้ง: ' pin_confirm; printf '\n'
    if [[ $ADMIN_PIN =~ ^[0-9]{4,8}$ && $ADMIN_PIN == "$pin_confirm" ]]; then break; fi
    printf 'PIN ต้องเป็นตัวเลข 4-8 หลักและตรงกัน กรุณากรอกใหม่\n' >&2
  done
}

run_sample_data() {
  # This helper is called under `set -e`; skipping optional sample data is a successful path.
  # A bare `[[ ... ]] || return` would return status 1 and abort setup after provisioning.
  if [[ $PROVISION_SAMPLE_STATUS != PENDING ]]; then
    return 0
  fi
  # provision-result.json is already mode 0600 inside the private VM and contains the one-time
  # token. From this point a sample-data interruption is retryable and cannot lose pairing.
  guest sudo sh -c '
    set -eu
    root=/var/lib/bms-retail-local
    raw="$root/.sample-result.$$"
    json="$root/.sample-result-json.$$"
    trap '\''rm -f "$raw" "$json"'\'' EXIT HUP INT TERM
    cd "$root"
    docker compose --env-file .env -f compose.yml --profile setup run --rm sample-data >"$raw" 2>&1 || true
    if grep -E '\''^\{"status"'\'' "$raw" | tail -n 1 >"$json" && [ -s "$json" ]; then
      :
    else
      printf '\''%s\n'\'' '\''{"status":"FAILED","requested":true,"message":"sample data process did not return a readable result"}'\'' >"$json"
    fi
    install -m 0600 "$json" "$root/sample-result.json"
  ' bms-runtime

  local result_file
  result_file="$STATE_ROOT/.sample-result-$(random_suffix).json"
  umask 077
  guest sudo cat /var/lib/bms-retail-local/sample-result.json >"$result_file" 2>/dev/null || true
  PROVISION_SAMPLE_STATUS=$(/usr/bin/plutil -extract status raw -o - "$result_file" 2>/dev/null || printf 'FAILED')
  rm -f -- "$result_file"
}

provision_shop() {
  if guest sudo test -f /var/lib/bms-retail-local/provision-result.json; then
    note "พบร้านที่ provision แล้ว ดำเนินการ setup ต่อจากครั้งก่อน"
    local checkpoint_file
    checkpoint_file="$STATE_ROOT/.provision-result-$(random_suffix).json"
    umask 077
    guest sudo cat /var/lib/bms-retail-local/provision-result.json >"$checkpoint_file" 2>/dev/null || true
    PROVISION_DEVICE_TOKEN=$(/usr/bin/plutil -extract deviceToken raw -o - "$checkpoint_file" 2>/dev/null || true)
    PROVISION_SAMPLE_STATUS=$(/usr/bin/plutil -extract sampleData.status raw -o - "$checkpoint_file" 2>/dev/null || true)
    rm -f -- "$checkpoint_file"
    run_sample_data
    case "$PROVISION_SAMPLE_STATUS" in
      COMPLETED|ALREADY_COMPLETED) note "สร้างข้อมูลตัวอย่างตามประเภทร้านแล้ว" ;;
      FAILED) printf '[คำแนะนำ] ข้อมูลตัวอย่างยังสร้างไม่ครบ ร้านยังใช้งานได้ และลองใหม่จากหน้าเริ่มต้นใช้งานได้\n' >&2 ;;
    esac
    return
  fi
  [[ -n $SHOP_NAME && -n $ADMIN_NAME && -n $ADMIN_EMAIL && -n $ADMIN_PASSWORD && -n $ADMIN_PIN &&
     -n $BUSINESS_ARCHETYPE && $CREATE_SAMPLE_DATA =~ ^[01]$ ]] || \
    die "ข้อมูล setup ไม่ครบ กรุณาเปิด Setup ใหม่"

  local provision_result result_file
  provision_result=$({
    printf '#!/bin/sh\nset -eu\numask 077\n'
    shell_export_line BMS_LOCAL_SHOP_NAME "$SHOP_NAME"
    shell_export_line BMS_LOCAL_SHOP_SLUG local-shop
    shell_export_line BMS_LOCAL_ADMIN_NAME "$ADMIN_NAME"
    shell_export_line BMS_LOCAL_ADMIN_EMAIL "$ADMIN_EMAIL"
    shell_export_line BMS_LOCAL_ADMIN_PASSWORD "$ADMIN_PASSWORD"
    shell_export_line BMS_LOCAL_ADMIN_PIN "$ADMIN_PIN"
    shell_export_line BMS_LOCAL_BUSINESS_ARCHETYPE "$BUSINESS_ARCHETYPE"
    shell_export_line BMS_LOCAL_CREATE_SAMPLE_DATA "$CREATE_SAMPLE_DATA"
    cat <<'EOF'
root=/var/lib/bms-retail-local
result="$root/.provision-result.$$"
trap 'rm -f "$result"' EXIT HUP INT TERM
cd "$root"
docker compose --env-file .env -f compose.yml --profile setup run --rm provision >"$result"
grep -E '^\{"status"' "$result" | tail -n 1 >"$root/provision-result.json"
chmod 0600 "$root/provision-result.json"
install -m 0600 /dev/null "$root/provisioned"
cat "$root/provision-result.json"
EOF
  } | "$LIMACTL" shell "$INSTANCE" sudo sh -s)
  result_file="$STATE_ROOT/.provision-result-$(random_suffix).json"
  umask 077
  printf '%s\n' "$provision_result" | grep -E '^\{"status"' | tail -n 1 >"$result_file"
  PROVISION_DEVICE_TOKEN=$(/usr/bin/plutil -extract deviceToken raw -o - "$result_file" 2>/dev/null || true)
  PROVISION_SAMPLE_STATUS=$(/usr/bin/plutil -extract sampleData.status raw -o - "$result_file" 2>/dev/null || true)
  rm -f -- "$result_file"
  [[ -z $PROVISION_DEVICE_TOKEN || $PROVISION_DEVICE_TOKEN =~ ^pos_[A-Za-z0-9_-]{16,}$ ]] || \
    die "ผลลัพธ์ pairing token ไม่ถูกต้อง"
  ADMIN_PASSWORD=""; ADMIN_PIN=""
  note "สร้างร้าน ผู้ดูแล สาขา MAIN และเครื่อง POS-01 แล้ว"
  run_sample_data
  case "$PROVISION_SAMPLE_STATUS" in
    COMPLETED|ALREADY_COMPLETED) note "สร้างข้อมูลตัวอย่างตามประเภทร้านแล้ว" ;;
    FAILED) printf '[คำแนะนำ] ข้อมูลตัวอย่างยังสร้างไม่ครบ ร้านยังใช้งานได้ และลองใหม่จากหน้าเริ่มต้นใช้งานได้\n' >&2 ;;
  esac
}

launch_pos_desktop() {
  [[ $(cat "$PAYLOAD_ROOT/PACKAGE_TYPE" 2>/dev/null || true) == server-pos ]] || return
  local pos_app="/Applications/BMS POS.app"
  [[ -d $pos_app ]] || die "แพ็กเกจ Server + POS ไม่มี BMS POS.app"
  if [[ -n $PROVISION_DEVICE_TOKEN ]]; then
    local expires_at handoff
    expires_at=$(date -v+10M -u '+%Y-%m-%dT%H:%M:%SZ')
    handoff="$STATE_ROOT/pairing-handoff-$(random_suffix).json"
    umask 077
    printf '%s\n' "{\"version\":1,\"serverUrl\":\"http://127.0.0.1:3100\",\"token\":\"$PROVISION_DEVICE_TOKEN\",\"expiresAt\":\"$expires_at\"}" >"$handoff"
    chmod 0600 "$handoff"
    open -a "$pos_app" --args "--pairing-handoff=$handoff"
    PROVISION_DEVICE_TOKEN=""
  else
    open -a "$pos_app"
  fi
}

write_receipt() {
  local version source_commit now package_arch platform_target
  version=$(cat "$PAYLOAD_ROOT/VERSION")
  source_commit=$(cat "$PAYLOAD_ROOT/SOURCE_COMMIT")
  package_arch=$(cat "$ARCH_FILE" 2>/dev/null || printf 'arm64')
  case "$package_arch" in
    arm64) platform_target=macos-15-arm64 ;;
    x64) platform_target=macos-15-x64 ;;
    *) die "package arch ไม่รองรับ: $package_arch" ;;
  esac
  now=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
  guest sudo sh -c 'printf "%s\n" "$1" > /var/lib/bms-retail-local/installation.json; chmod 0600 /var/lib/bms-retail-local/installation.json' \
    bms-runtime "{\"product\":\"BMS Retail Local\",\"version\":\"$version\",\"platformTarget\":\"$platform_target\",\"installedAt\":\"$now\",\"sourceCommit\":\"$source_commit\",\"url\":\"http://127.0.0.1:3100\"}"
  umask 077
  printf '%s\n' "{\"product\":\"BMS Retail Local\",\"version\":\"$version\",\"platformTarget\":\"$platform_target\",\"installedAt\":\"$now\",\"sourceCommit\":\"$source_commit\",\"url\":\"http://127.0.0.1:$WEB_PORT\"}" >"$RECEIPT.tmp"
  mv -f "$RECEIPT.tmp" "$RECEIPT"
}

render_launch_agent() {
  mkdir -p "$HOME/Library/LaunchAgents" "$STATE_ROOT"
  local control log
  control=$(yaml_escape_sed "$SYSTEM_ROOT/control/bms-retail-local")
  log=$(yaml_escape_sed "$LOG_PATH")
  sed -e "s|__HOST_CONTROL__|$control|g" -e "s|__LOG_PATH__|$log|g" \
    "$CONTROL_ROOT/com.bms.retail-local.plist.template" >"$LAUNCH_AGENT.tmp"
  plutil -lint "$LAUNCH_AGENT.tmp" >/dev/null
  chmod 0600 "$LAUNCH_AGENT.tmp"
  mv -f "$LAUNCH_AGENT.tmp" "$LAUNCH_AGENT"
}

install_launch_agent() {
  render_launch_agent
  launchctl bootout "gui/$(id -u)" "$LAUNCH_AGENT" >/dev/null 2>&1 || true
  launchctl bootstrap "gui/$(id -u)" "$LAUNCH_AGENT"
  launchctl kickstart -k "$LAUNCH_LABEL"
}

http_ready() {
  curl --fail --silent --max-time 5 "http://127.0.0.1:$WEB_PORT/admin/login" >/dev/null && \
    curl --fail --silent --max-time 5 "http://127.0.0.1:$WS_PORT/readyz" >/dev/null
}

wait_for_http() {
  local deadline=$((SECONDS + 300))
  until http_ready; do
    (( SECONDS < deadline )) || die "บริการไม่ผ่าน HTTP health check ดู log ด้วย: bms-retail-local logs"
    sleep 3
  done
}

ensure_runtime() {
  [[ -f $RECEIPT ]] || die "ยัง setup ไม่เสร็จ"
  require_installed_payload
  if http_ready; then
    note "Retail Local ทำงานอยู่แล้ว"
    return
  fi
  render_launch_agent
  if launchctl print "$LAUNCH_LABEL" >/dev/null 2>&1; then
    # Do not use -k here: a second POS launch must not kill a VM that is already booting.
    launchctl kickstart "$LAUNCH_LABEL"
  else
    launchctl bootstrap "gui/$(id -u)" "$LAUNCH_AGENT"
    launchctl kickstart "$LAUNCH_LABEL"
  fi
  wait_for_http
  note "พร้อมใช้งาน: http://127.0.0.1:$WEB_PORT"
}

wait_for_guest_doctor() {
  local deadline=$((SECONDS + 300))
  until guest sudo /usr/local/bin/bms-localctl doctor >/dev/null 2>&1; do
    if (( SECONDS >= deadline )); then
      guest sudo /usr/local/bin/bms-localctl status || true
      die "บริการใน private VM ไม่ผ่าน health check ดู log ด้วย: bms-retail-local logs"
    fi
    sleep 3
  done
  guest sudo /usr/local/bin/bms-localctl doctor
}

setup_runtime() {
  require_installed_payload
  [[ ! -f $RECEIPT ]] || die "ติดตั้งเรียบร้อยแล้ว ใช้คำสั่ง status หรือ doctor แทน"
  step 1 "ตรวจสอบ macOS, CPU, RAM, Virtualization และพื้นที่ว่าง"
  "$AGENT" preflight --human || die "ยังติดตั้งไม่ได้ กรุณาแก้ไขรายการ preflight ด้านบนแล้วเปิด BMS Retail Local อีกครั้ง"
  step 2 "ตรวจสอบไฟล์ติดตั้ง"
  verify_payload
  render_lima_config
  step 3 "เตรียม private runtime"
  start_setup_vm
  if ! guest sudo test -f /var/lib/bms-retail-local/provisioned; then
    step 4 "รับข้อมูลร้านและผู้ดูแล"
    collect_shop_details
  else
    step 4 "พบข้อมูลร้านเดิม กำลังติดตั้งต่อจากจุดที่ค้าง"
  fi
  step 5 "ติดตั้ง Web, WS, PostgreSQL และ Redis"
  install_release
  provision_shop
  step 6 "เริ่มบริการและตรวจสุขภาพระบบ"
  guest sudo /usr/local/bin/bms-localctl start
  wait_for_http
  wait_for_guest_doctor
  write_receipt
  if [[ ${BMS_RETAIL_LOCAL_TEST_MODE:-0} != 1 ]]; then
    "$LIMACTL" stop "$INSTANCE"
    install_launch_agent
    wait_for_http
    launch_pos_desktop
  fi
  guest sudo rm -f /var/lib/bms-retail-local/provision-result.json /var/lib/bms-retail-local/sample-result.json
  step 7 "ติดตั้งสำเร็จ"
  note "พร้อมใช้งาน: http://127.0.0.1:$WEB_PORT"
}

start_runtime() {
  ensure_runtime
}

stop_runtime() {
  launchctl bootout "gui/$(id -u)" "$LAUNCH_AGENT" >/dev/null 2>&1 || true
  if [[ $(instance_status) == Running ]]; then "$LIMACTL" stop "$INSTANCE"; fi
  note "หยุด Retail Local แล้ว"
}

uninstall_runtime() {
  local erase_data=false confirmation=""
  while (($#)); do
    case "$1" in
      --erase-data) erase_data=true; shift ;;
      --confirm) confirmation=${2:-}; shift 2 ;;
      *) die "usage: bms-retail-local uninstall [--erase-data --confirm ERASE-BMS-RETAIL-LOCAL]" ;;
    esac
  done

  if [[ ${EUID:-$(id -u)} -eq 0 && -z ${BMS_RETAIL_LOCAL_ALLOW_ROOT_UNINSTALL:-} ]]; then
    die "อย่ารัน uninstall ด้วย sudo โดยตรง เพราะข้อมูลร้านอยู่ใต้ user ที่ setup ให้รันแบบ user ปกติ"
  fi

  launchctl bootout "gui/$(id -u)" "$LAUNCH_AGENT" >/dev/null 2>&1 || true
  if [[ -x $LIMACTL && $(instance_status) == Running ]]; then "$LIMACTL" stop "$INSTANCE" || true; fi
  rm -f -- "$LAUNCH_AGENT"

  if [[ $erase_data != true ]]; then
    note "หยุดและถอด startup แล้ว"
    note "ข้อมูลร้าน, private VM และ secrets ยังอยู่ใน: $STATE_ROOT"
    note "ใช้ bms-retail-local backup ก่อน และใช้ uninstall --erase-data เฉพาะเมื่อต้องการลบถาวร"
    return
  fi

  if [[ -z $confirmation ]]; then
    read -r -p 'การลบถาวรกู้คืนไม่ได้ พิมพ์ ERASE-BMS-RETAIL-LOCAL: ' confirmation
  fi
  [[ $confirmation == ERASE-BMS-RETAIL-LOCAL ]] || die "ยกเลิกการลบข้อมูล"

  if [[ -x $LIMACTL ]]; then
    "$LIMACTL" delete -f "$INSTANCE" >/dev/null 2>&1 || true
  fi
  local package_type pos_app_target=""
  package_type=$(cat "$PAYLOAD_ROOT/PACKAGE_TYPE" 2>/dev/null || true)
  [[ $package_type != server-pos ]] || pos_app_target="/Applications/BMS POS.app"
  rm -rf -- "$STATE_ROOT" "$LIMA_HOME"
  if [[ -n $pos_app_target ]]; then
    sudo rm -rf -- "$SYSTEM_ROOT" "/Applications/BMS Retail Local.app" "$pos_app_target"
  else
    sudo rm -rf -- "$SYSTEM_ROOT" "/Applications/BMS Retail Local.app"
  fi
  sudo rm -f -- "/Applications/BMS Retail Local Uninstall.command"
  sudo rm -f -- /usr/local/bin/bms-retail-local
  sudo pkgutil --forget com.base2526.bms.retail-local >/dev/null 2>&1 || true
  note "ลบ BMS Retail Local และข้อมูลในเครื่องแล้ว"
}

show_status() {
  require_installed_payload
  printf 'Version: %s\n' "$(cat "$PAYLOAD_ROOT/VERSION")"
  printf 'Runtime: %s\n' "$(instance_status | sed 's/^$/Not created/')"
  if [[ $(instance_status) == Running ]]; then
    guest sudo /usr/local/bin/bms-localctl status
  fi
}

doctor() {
  [[ $(instance_status) == Running ]] || die "runtime ไม่ได้ทำงาน"
  guest sudo /usr/local/bin/bms-localctl doctor
  curl --fail --silent --max-time 5 "http://127.0.0.1:$WEB_PORT/admin/login" >/dev/null
  curl --fail --silent --max-time 5 "http://127.0.0.1:$WS_PORT/readyz" >/dev/null
  note "host forwarding: healthy"
}

backup_runtime() {
  local output=${1:-} recipient=${2:-}
  [[ -n $output && $recipient =~ ^age1[0-9a-z]{58}$ ]] || \
    die "usage: bms-retail-local backup OUTPUT.age AGE_RECIPIENT"
  [[ $(instance_status) == Running ]] || die "runtime ไม่ได้ทำงาน"
  [[ ! -e $output ]] || die "ไฟล์ปลายทางมีอยู่แล้ว"
  local name guest_path temporary
  name="backup-$(date -u '+%Y%m%dT%H%M%SZ')-$(random_suffix).age"
  guest_path="/var/lib/bms-retail-local/backups/$name"
  temporary="$output.part"
  guest sudo /usr/local/bin/bms-localctl backup "$guest_path" --recipient "$recipient"
  "$LIMACTL" copy --backend=scp "$INSTANCE:$guest_path" "$temporary"
  chmod 0600 "$temporary"
  mv "$temporary" "$output"
  guest sudo sh -c 'rm -f -- "$1"' bms-runtime "$guest_path"
  shasum -a 256 "$output" >"$output.sha256"
  note "backup พร้อม: $output"
}

host_service() {
  [[ -f $RECEIPT ]] || exit 0
  require_installed_payload
  exec "$LIMACTL" start --foreground --tty=false --timeout 10m "$INSTANCE"
}

case "${1:-}" in
  setup) setup_runtime ;;
  start) start_runtime ;;
  ensure-running) ensure_runtime ;;
  stop) stop_runtime ;;
  restart) stop_runtime; start_runtime ;;
  uninstall) shift; uninstall_runtime "$@" ;;
  status) show_status ;;
  doctor) doctor ;;
  backup) shift; backup_runtime "$@" ;;
  logs)
    tail -n 160 "$LOG_PATH" 2>/dev/null || true
    [[ $(instance_status) == Running ]] && guest sudo sh -c 'cd /var/lib/bms-retail-local && docker compose --env-file .env -f compose.yml logs --tail=160' || true
    ;;
  open) open "http://127.0.0.1:$WEB_PORT/admin/login" ;;
  host-service) host_service ;;
  *)
    die "usage: bms-retail-local <setup|start|ensure-running|stop|restart|uninstall|status|doctor|backup|logs|open>"
    ;;
esac
