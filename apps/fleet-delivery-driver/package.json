{
  "name": "bms-delivery-driver",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android --appId com.bms.delivery.driver.debug",
    "ios": "node ../fleet-delivery-customer/scripts/run-ios-simulator.mjs --driver",
    "ios:build": "xcodebuild -workspace ios/BmsDeliveryDriver.xcworkspace -scheme BmsDeliveryDriver -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -derivedDataPath ios/build/DerivedData CODE_SIGN_IDENTITY=- CODE_SIGNING_ALLOWED=YES build",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "test:ci": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "verify:security-patch": "node scripts/verify-braces-security-patch.mjs",
    "verify:supply-chain": "node scripts/verify-supply-chain.mjs",
    "verify:audit-boundary": "node scripts/verify-audit-boundary.mjs",
    "verify:device-safety": "node scripts/verify-device-safety-boundary.mjs",
    "device:inventory": "node scripts/device-inventory.mjs",
    "verify:licenses": "node scripts/verify-licenses.mjs",
    "verify:reproducibility": "node scripts/verify-bundle-reproducibility.mjs"
  },
  "dependencies": {
    "@react-native-community/geolocation": "3.4.0",
    "react-native-maps": "1.29.11",
    "@bms/fleet-delivery-contracts": "file:../../packages/fleet-delivery-contracts",
    "@bms/fleet-delivery-driver-core": "file:../fleet-delivery-driver-core",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "braces": "file:vendor/braces",
    "fill-range": "7.1.1",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-keychain": "10.0.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/runtime": "7.29.10",
    "@babel/plugin-transform-export-namespace-from": "7.29.7",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.3.0",
    "@types/react-test-renderer": "19.3.0",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "6.0.3"
  },
  "overrides": {
    "braces": "$braces"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
