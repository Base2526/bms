# production
# whosscam.com {
#  tls whosscam.io@gmail.com
#  reverse_proxy /graphql* ws:8080
#  reverse_proxy web:3000
#}

# whosscam.com {
#   tls whosscam.io@gmail.com

#   # ✅ บีบอัด response ช่วยได้มาก โดยเฉพาะ _next/static
#   encode zstd gzip

#   # ✅ cache static assets ของ Next.js
#   @nextStatic path /_next/static/*
#   header @nextStatic Cache-Control "public, max-age=31536000, immutable"

#   # (ถ้าคุณเสิร์ฟรูปจาก /public หรือไฟล์คงที่อื่น)
#   @publicStatic path /favicon.ico /robots.txt /sitemap.xml /images/* /static/*
#   header @publicStatic Cache-Control "public, max-age=86400"

#   # ✅ WebSocket GraphQL (subscriptions)
#   @ws {
#     path /graphql
#     header Connection *Upgrade*
#     header Upgrade websocket
#   }
#   reverse_proxy @ws ws:8080

#   # ✅ GraphQL แบบ HTTP (ถ้าคุณมี endpoint นี้ที่ web)
#   @gql_http path /graphql*
#   reverse_proxy @gql_http web:3000

#   # ที่เหลือไป Next.js web
#   reverse_proxy web:3000
# }

# www.whosscam.com {
#   tls whosscam.io@gmail.com
#   redir https://whosscam.com{uri} 308
# }


#localhost
# whosscam.com {
#    tls /certs/whosscam.com.pem /certs/whosscam.com-key.pem
#    reverse_proxy /graphql* ws:8080
#    reverse_proxy web:3000
# }

jachoei.com {
   tls /certs/jachoei.com.pem /certs/jachoei.com-key.pem

   @gqlUpload {
     path /api/graphql
     header Content-Type multipart/form-data*
   }
   request_body @gqlUpload {
     max_size 64MB
   }
   @gqlJson {
     path /api/graphql
     header Content-Type application/json*
   }
   request_body @gqlJson {
     max_size 1MB
   }
   @smallUpload path /api/bms/store-profile/logo/upload /api/bms/store-profile/customer-display-background/upload /api/bms/queue-board/media/upload
   request_body @smallUpload {
     max_size 6MB
   }
   @mediumUpload path /api/bms/products/upload /api/bms/inbox/upload
   request_body @mediumUpload {
     max_size 11MB
   }
   @checkoutUpload path /api/bms/checkout/payment
   request_body @checkoutUpload {
     max_size 9MB
   }
   @boardGameDeposit path /api/board-game/bookings/*/payment
   request_body @boardGameDeposit {
     max_size 10MB
   }
   @clinicalAndFishUpload path /api/pos/pharmacy-evidence /api/bms/pharmacy/evidence/upload /api/bms/fish-intake/import
   request_body @clinicalAndFishUpload {
     max_size 12MB
   }
   @filesUpload path /api/files
   @restaurantKiosk path /api/bms/restaurant-kiosk/* /api/bms/restaurant-kiosk-device /api/bms/restaurant-kiosk-devices
   request_body @restaurantKiosk {
     max_size 32KB
   }
   request_body @filesUpload {
     max_size 26MB
   }

   @ws {
     path /graphql
     header Connection *Upgrade*
     header Upgrade websocket
   }
   reverse_proxy @ws ws:8080

   @gql_http path /graphql*
   reverse_proxy @gql_http web:3000

   reverse_proxy web:3000
}

# Android Emulator keeps the paired origin as http://localhost:3000. ADB maps
# that device port to host port 3001, where this listener preserves the single
# origin contract while routing WebSocket upgrades to the database-free gateway.
# docker-compose.dev.yml publishes this port on host loopback only.
:3001 {
   @gqlUpload {
     path /api/graphql
     header Content-Type multipart/form-data*
   }
   request_body @gqlUpload {
     max_size 64MB
   }
   @gqlJson {
     path /api/graphql
     header Content-Type application/json*
   }
   request_body @gqlJson {
     max_size 1MB
   }
   @smallUpload path /api/bms/store-profile/logo/upload /api/bms/store-profile/customer-display-background/upload /api/bms/queue-board/media/upload
   request_body @smallUpload {
     max_size 6MB
   }
   @mediumUpload path /api/bms/products/upload /api/bms/inbox/upload
   request_body @mediumUpload {
     max_size 11MB
   }
   @checkoutUpload path /api/bms/checkout/payment
   request_body @checkoutUpload {
     max_size 9MB
   }
   @filesUpload path /api/files
   @restaurantKiosk path /api/bms/restaurant-kiosk/* /api/bms/restaurant-kiosk-device /api/bms/restaurant-kiosk-devices
   request_body @restaurantKiosk {
     max_size 32KB
   }
   request_body @filesUpload {
     max_size 26MB
   }

   @ws {
     path /graphql
     header Connection *Upgrade*
     header Upgrade websocket
   }
   reverse_proxy @ws ws:8080

   reverse_proxy web:3000
}
