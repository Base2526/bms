# production
# whosscam.com {
#  tls whosscam.io@gmail.com
#  reverse_proxy /graphql* ws:8080
#  reverse_proxy web:3000
#}

bms.jachoei.com {
   tls whosscam.io@gmail.com

   encode zstd gzip

   @nextStatic path /_next/static/*
   header @nextStatic Cache-Control "public, max-age=31536000, immutable"

   @publicStatic path /favicon.ico /robots.txt /sitemap.xml /images/* /static/*
   header @publicStatic Cache-Control "public, max-age=86400"

   @gqlUpload {
     path /api/graphql
     header Content-Type multipart/form-data*
   }
   request_body @gqlUpload {
     max_size 64MB
   }
   @gqlJson {
     path /api/graphql
     header Content-Type application/json*
   }
   request_body @gqlJson {
     max_size 1MB
   }
   @smallUpload path /api/bms/store-profile/logo/upload /api/bms/store-profile/customer-display-background/upload /api/bms/queue-board/media/upload
   request_body @smallUpload {
     max_size 6MB
   }
   @mediumUpload path /api/bms/products/upload /api/bms/inbox/upload
   request_body @mediumUpload {
     max_size 11MB
   }
   @checkoutUpload path /api/bms/checkout/payment
   request_body @checkoutUpload {
     max_size 9MB
   }
   @boardGameDeposit path /api/board-game/bookings/*/payment
   request_body @boardGameDeposit {
     max_size 10MB
   }
   @clinicalAndFishUpload path /api/pos/pharmacy-evidence /api/bms/pharmacy/evidence/upload /api/bms/fish-intake/import
   request_body @clinicalAndFishUpload {
     max_size 12MB
   }
   @filesUpload path /api/files
   @restaurantKiosk path /api/bms/restaurant-kiosk/*
   request_body @restaurantKiosk {
     max_size 32KB
   }
   request_body @filesUpload {
     max_size 26MB
   }

   @ws {
     path /graphql
     header Connection *Upgrade*
     header Upgrade websocket
   }
   reverse_proxy @ws ws:8080

   @gql_http path /graphql*
   reverse_proxy @gql_http web:3000

   reverse_proxy web:3000
}

# Immutable Retail Local payloads published by the Web service. Compose mounts
# the same RETAIL_LOCAL_RELEASE_HOST_DIR at /srv/bms-releases read-only.
releases.jachoei.com {
   tls whosscam.io@gmail.com

   root * /srv/bms-releases
   encode zstd gzip

   header {
     X-Content-Type-Options "nosniff"
   }

   @versionedRelease path /retail-local/*
   header @versionedRelease Cache-Control "public, max-age=31536000, immutable"

   file_server
}

jachoei.com {
   redir https://bms.jachoei.com{uri} 308
}

