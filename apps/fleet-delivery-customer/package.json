{
  "name": "bms-delivery-customer",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:assemble": "./android/gradlew assembleDebug assembleRelease",
    "ios": "node scripts/run-ios-simulator.mjs",
    "ios:pods": "cd ios && pod install",
    "ios:build": "xcodebuild -workspace ios/BmsDeliveryCustomer.xcworkspace -scheme BmsDeliveryCustomer -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -derivedDataPath ios/build/DerivedData CODE_SIGN_IDENTITY=- CODE_SIGNING_ALLOWED=YES build",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "test:ci": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "verify:native-boundary": "node scripts/verify-native-boundary.mjs"
  },
  "dependencies": {
    "@bms/fleet-delivery-contracts": "file:../../packages/fleet-delivery-contracts",
    "@bms/fleet-delivery-customer-core": "file:../fleet-delivery-customer-core",
    "braces": "file:../fleet-delivery-driver/vendor/braces",
    "fill-range": "7.1.1",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-keychain": "10.0.0",
    "react-native-safe-area-context": "5.10.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-export-namespace-from": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/runtime": "7.29.10",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.3.0",
    "@types/react-test-renderer": "19.3.0",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "6.0.3"
  },
  "overrides": {
    "braces": "$braces"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
