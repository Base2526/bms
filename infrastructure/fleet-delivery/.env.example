# Development-only example. Copy to an ignored .env file and replace every password.
FLEET_DELIVERY_POSTGRES_DB=fleet_delivery
FLEET_DELIVERY_POSTGRES_OWNER=fleet_delivery_owner
FLEET_DELIVERY_POSTGRES_OWNER_PASSWORD=change-me-owner-local-only
FLEET_DELIVERY_APP_DB_PASSWORD=change-me-app-local-only
FLEET_DELIVERY_WORKER_DB_PASSWORD=change-me-worker-local-only
FLEET_DELIVERY_MIGRATION_DATABASE_URL=postgresql://fleet_delivery_owner:change-me-owner-local-only@postgres:5432/fleet_delivery
FLEET_DELIVERY_DATABASE_URL=postgresql://fleet_delivery_app:change-me-app-local-only@postgres:5432/fleet_delivery
FLEET_DELIVERY_WORKER_DATABASE_URL=postgresql://fleet_delivery_worker:change-me-worker-local-only@postgres:5432/fleet_delivery
FLEET_DELIVERY_REDIS_URL=redis://redis:6379
FLEET_DELIVERY_POSTGRES_HOST_PORT=55432
FLEET_DELIVERY_REDIS_HOST_PORT=56379
FLEET_DELIVERY_API_PORT=4100
FLEET_DELIVERY_API_HOST_PORT=4100
FLEET_DELIVERY_SHUTDOWN_TIMEOUT_MS=15000
FLEET_DELIVERY_DB_POOL_MAX=10
FLEET_DELIVERY_MAX_BODY_BYTES=65536
FLEET_DELIVERY_SERVICE_RATE_LIMIT_PER_MINUTE=120
FLEET_DELIVERY_OUTBOX_POLL_MS=500
FLEET_DELIVERY_OUTBOX_BATCH_SIZE=25
FLEET_DELIVERY_OUTBOX_LEASE_SECONDS=30
FLEET_DELIVERY_DISPATCH_BATCH_SIZE=10
FLEET_DELIVERY_DISPATCH_LEASE_SECONDS=30
FLEET_DELIVERY_MIGRATIONS_DIR=/app/migrations
FLEET_DELIVERY_COMPOSE_FILE=infrastructure/fleet-delivery/docker-compose.yml
FLEET_DELIVERY_RESTORE_VERIFY_DB=fleet_delivery_restore_verify

# Leave blank during Phase 1 unless using an ephemeral synthetic test key set.
# Production startup fails if these are absent.
FLEET_DELIVERY_SERVICE_JWKS_JSON=
FLEET_DELIVERY_SERVICE_ISSUER=
FLEET_DELIVERY_SERVICE_AUDIENCE=fleet-delivery

# DB contract tests only. Leave blank outside a disposable local test environment.
FLEET_DELIVERY_TEST_DATABASE_URL=
FLEET_DELIVERY_TEST_REDIS_URL=
